@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

@{
    ViewData["Title"] = "Роли";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .roles-container {
            background: linear-gradient(135deg, #222222 0%, #444444 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .roles-header {
            background: #fff;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            text-align: center;
        }

        .roles-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 10px;
        }

        .roles-subtitle {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 25px;
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: #f5f5f5;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            min-width: 150px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
            color: #222;
        }

        .stat-label {
            color: #555;
            font-size: 0.9rem;
        }

        .actions-section {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
        }

        .btn-create {
            background: #222;
            color: #fff;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                background: #444;
                box-shadow: 0 10px 20px rgba(0,0,0,0.4);
                color: #fff;
                transform: translateY(-2px);
            }

        .roles-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .role-card {
            background: #fff;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .role-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

            .role-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: #333;
            }

        .role-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .role-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111;
        }

        .role-id {
            background: #666;
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .role-info {
            margin-bottom: 20px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .info-label {
            font-weight: 600;
            color: #444;
        }

        .info-value {
            color: #222;
            font-weight: 500;
        }

        .role-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            font-size: 0.9rem;
            color: #fff;
        }

        .btn-permissions {
            background: #222;
        }

            .btn-permissions:hover {
                background: #444;
                box-shadow: 0 5px 15px rgba(0,0,0,0.4);
                transform: translateY(-2px);
            }

        .btn-edit {
            background: #666;
            color: #fff;
        }

            .btn-edit:hover {
                background: #888;
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                transform: translateY(-2px);
            }

        .btn-delete {
            background: #a00;
        }

            .btn-delete:hover {
                background: #c33;
                box-shadow: 0 5px 15px rgba(170,0,0,0.4);
                transform: translateY(-2px);
            }

        .no-roles {
            background: #fff;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            color: #222;
        }

        .no-roles-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .roles-grid {
                grid-template-columns: 1fr;
            }

            .stats-container {
                flex-direction: column;
                align-items: center;
            }

            .roles-title {
                font-size: 2rem;
            }

            .actions-section {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
                width: 100%;
            }

                .actions-section .btn-create {
                    width: 100%;
                    max-width: none;
                    box-sizing: border-box;
                    padding: 12px 20px;
                    font-size: 0.95rem;
                }
        }

        @@media (max-width: 400px) {
            .actions-section .btn-create {
                padding: 10px 15px;
                font-size: 0.85rem;
            }

            .stat-number {
                font-size: 1.5rem;
            }
        }
    </style>
}

<div class="roles-container">
    <div class="roles-header">
        <h1 class="roles-title"><i class="bi bi-shield-lock-fill me-2"></i>Роли</h1>
        <p class="roles-subtitle">Управление ролями и правами доступа</p>

        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-number">@Model.Count</div>
                <div class="stat-label"><i class="bi bi-shield-lock-fill me-1"></i>Всего ролей</div>
            </div>
        </div>

        <div class="actions-section">
            <permission asp-permission="@Restaurant.Authorization.Permissions.Roles.Manage">
                <a asp-action="Create" class="btn-create">
                    <i class="bi bi-plus-lg me-1"></i>Добавить роль
                </a>
            </permission>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="no-roles">
            <div class="no-roles-icon">🔐</div>
            <h3>Ролей пока нет</h3>
            <p>Создайте первую роль для начала работы</p>
            <a asp-action="Create" class="btn-create">➕ Создать роль</a>
        </div>
    }
    else
    {
        <div class="roles-grid">
            @foreach (var role in Model)
            {
                <div class="role-card">
                    <div class="role-header">
                        <div class="role-name">@role.Name</div>
                        <!--<span class="role-id">#@role.Id</span>-->
                    </div>

                    <div class="role-info">
                        <div class="info-row">
                            <div class="info-label">
                                <i class="bi bi-card-text me-1"></i>Название:
                            </div>
                            <span class="info-value">@role.Name</span>
                        </div>
                    </div>

                    <div class="role-actions">
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Roles.Manage">
                            <a asp-action="Permissions" asp-route-id="@role.Id" class="btn-action btn-permissions">
                                <i class="bi bi-key-fill me-1"></i>Права
                            </a>
                        </permission>
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Roles.Manage">
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@role.Id" />
                                <button class="btn-action btn-delete" onclick="return confirm('Удалить роль \" @role.Name\"?')">
                                    <i class="bi bi-trash-fill me-1"></i>Удалить
                                </button>
                            </form>
                        </permission>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    // Анимация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.role-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';

            setTimeout(() => {
                card.style.transition = 'all 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });
</script>
