@model List<Restaurant.Entities.Category>

@{
    ViewData["Title"] = "Категории";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .categories-container {
            background: linear-gradient(135deg, #222222 0%, #444444 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .categories-header {
            background: #fff;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            text-align: center;
        }

        .categories-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 10px;
        }

        .categories-subtitle {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 25px;
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: #f5f5f5;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            min-width: 150px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
            color: #222;
        }

        .stat-label {
            color: #555;
            font-size: 0.9rem;
        }

        .actions-section {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
        }

        .btn-create {
            background: #222;
            color: #fff;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                background: #444;
                box-shadow: 0 10px 20px rgba(0,0,0,0.4);
                color: #fff;
                transform: translateY(-2px);
            }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .category-card {
            background: #fff;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

            .category-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

            .category-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: #333;
            }

        .category-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .category-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111;
        }

        .category-id {
            background: #666;
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .category-info {
            margin-bottom: 20px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .info-label {
            font-weight: 600;
            color: #444;
        }

        .info-value {
            color: #222;
            font-weight: 500;
        }

        .category-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            font-size: 0.9rem;
            color: #fff;
        }

        .btn-edit {
            background: #666;
        }

            .btn-edit:hover {
                background: #888;
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                transform: translateY(-2px);
            }

        .btn-delete {
            background: #a00;
        }

            .btn-delete:hover {
                background: #c33;
                box-shadow: 0 5px 15px rgba(170,0,0,0.4);
                transform: translateY(-2px);
            }

        .no-categories {
            background: #fff;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            color: #222;
        }

        .no-categories-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .categories-grid {
                grid-template-columns: 1fr;
            }

            .stats-container {
                flex-direction: column;
                align-items: center;
            }

            .categories-title {
                font-size: 2rem;
            }

            .actions-section {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
                width: 100%;
            }

                .actions-section .btn-create {
                    width: 100%;
                    max-width: none;
                    box-sizing: border-box;
                    padding: 12px 20px;
                    font-size: 0.95rem;
                    word-wrap: break-word;
                    white-space: normal;
                    text-align: center;
                }
        }

        @@media (max-width: 400px) {
            .actions-section .btn-create {
                padding: 8px 12px;
                font-size: 0.8rem;
            }

            .stat-number {
                font-size: 1.5rem;
            }
        }
    </style>
}

<div class="categories-container">
    <div class="categories-header">
        <h1 class="categories-title"><i class="bi bi-folder"></i> Категории</h1>
        <p class="categories-subtitle">Управление категориями продуктов</p>

        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-number">@Model.Count</div>
                <div class="stat-label"><i class="bi bi-folder"></i> Всего категорий</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.Sum(c => c.Products?.Count ?? 0)</div>
                <div class="stat-label">🍽️ Всего продуктов</div>
            </div>
        </div>

        <div class="actions-section">
            <permission asp-permission="@Restaurant.Authorization.Permissions.Categories.Create">
                <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn-create">
                    ➕ Создать
                </a>
            </permission>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="no-categories">
            <div class="no-categories-icon">📂</div>
            <h3>Категорий пока нет</h3>
            <p>Создайте первую категорию для начала работы</p>
        </div>
    }
    else
    {
        <div class="categories-grid">
            @foreach (var category in Model)
            {
                <div class="category-card" onclick="window.location.href='@Url.Action("Details", "Category", new { area = "Admin", id = category.Id })'">
                    <div class="category-header">
                        <div class="category-name">@category.Name</div>
                        <span class="category-id">#@category.Id</span>
                    </div>

                    <div class="category-info">
                        <div class="info-row">
                            <span class="info-label">Продуктов:</span>
                            <span class="info-value">@(category.Products?.Count ?? 0)</span>
                        </div>
                    </div>

                    <div class="category-actions" onclick="event.stopPropagation()">
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Products.Create">
                            <a asp-area="Admin" asp-controller="Product" asp-action="Create" asp-route-categoryId="@category.Id" class="btn-action btn-create">
                                Добавить продукт
                            </a>
                        </permission>
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Categories.Edit">
                            <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="btn-action btn-edit">
                                Редактировать
                            </a>
                        </permission>
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Categories.Delete">
                            <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline">
                                <button class="btn-action btn-delete" onclick="return confirm('Удалить категорию " @category.Name"?')">
                                    Удалить
                                </button>
                            </form>
                        </permission>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    // Анимация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.category-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';

            setTimeout(() => {
                card.style.transition = 'all 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });
</script>
