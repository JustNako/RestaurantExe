@model List<Restaurant.ViewModels.EditEmployeeViewModel>
@{
    ViewData["Title"] = "Сотрудники";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    /* --- Адаптивные стили для фильтров --- */
    @@media (max-width: 767.98px) {
        /* Мобильные устройства */
        #search

    {
        font-size: 1rem;
    }

    #roleFilter {
        font-size: 1rem;
    }

    /* Вертикальное расположение фильтров */
    .filters-row {
        flex-direction: column !important;
        gap: 1rem !important;
    }

    }

    @@media (min-width: 768px) and (max-width: 991.98px) {
        /* Планшеты */
        .filters-row

    {
        flex-wrap: nowrap !important;
        gap: 1rem !important;
    }

    }

    /* Card-based layout for mobile devices */
    @@media (max-width: 750px) {
        .table-responsive {
            border: none;
        }
        #usersTable thead {
            display: none;
        }
        #usersTable tbody, #usersTable tr, #usersTable td {
            display: block;
            width: 100%;
        }
        #usersTable tr {
            margin-bottom: 1rem;
            border: 1px solid #dee2e6;
            border-radius: .25rem;
            background-color: #fff;
        }
        #usersTable td {
            padding: 1rem;
            position: relative;
            padding-left: 50%;
            text-align: right;
            border: none;
        }
        #usersTable td:before {
            content: attr(data-label);
            position: absolute;
            left: .5rem;
            width: 45%;
            padding-right: .5rem;
            font-weight: bold;
            text-align: left;
            white-space: nowrap;
        }
        #usersTable td:last-child {
            text-align: right;
            padding-left: 1rem; /* Reset padding for action buttons */
        }
    }

    /* --- Адаптация под очень маленькие экраны (≤ 440px) --- */
    @@media (max-width: 440px) {
        /* Заголовок и кнопка добавления сотрудника */
        h2

    {
        font-size: 1.25rem; /* уменьшить размер заголовка */
    }

    .btn {
        font-size: 0.85rem;
        padding: 0.4rem 0.75rem;
    }

    /* Фильтры */
    #search, #roleFilter {
        font-size: 0.9rem;
        padding: 0.5rem;
    }

    .filters-row {
        flex-direction: column !important;
        gap: 0.75rem !important;
    }

    /* Таблица в карточном виде */
    #usersTable tr {
        margin-bottom: 0.75rem;
    }

    #usersTable td {
        padding: 0.75rem;
        padding-left: 45%; /* чуть меньше отступ */
        font-size: 0.9rem;
    }

        #usersTable td:before {
            font-size: 0.85rem;
            width: 40%; /* уменьшить ширину метки */
        }

    /* Кнопки действий */
    .btn-sm {
        font-size: 0.8rem;
        padding: 0.3rem 0.55rem;
    }

    #usersTable td:last-child {
        text-align: center; /* выравнивание кнопок по центру */
        padding-left: 0.5rem;
    }

    }



    /* Немного увеличим кнопки на мобильных */
    @@media (max-width: 575.98px) {
        .btn-sm

    {
        padding: 0.375rem 0.6rem;
        font-size: 0.875rem;
    }

    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h2 class="mb-0 d-flex align-items-center gap-2">
            Сотрудники
            <i class="bi bi-people-fill fs-4 text-primary"></i>
        </h2>
        <a asp-action="Create" class="btn btn-success d-flex align-items-center gap-1 px-4 shadow-sm" title="Добавить сотрудника">
            <i class="bi bi-person-plus-fill fs-5"></i> Добавить сотрудника
        </a>
    </div>

    @{
        var roleOptions = ViewBag.RoleOptions as List<string> ?? new List<string>();
    }

    <div class="card shadow-sm mb-4 p-3">
        <div class="row g-3 align-items-center filters-row d-flex">
            <div class="col-12 col-md-6 col-lg-4">
                <label for="search" class="form-label visually-hidden">Поиск по имени или телефону</label>
                <input id="search" type="search" class="form-control form-control-lg" placeholder="Поиск: имя или телефон" />
            </div>
            <div class="col-12 col-md-4 col-lg-3">
                <label for="roleFilter" class="form-label visually-hidden">Фильтр по роли</label>
                <select id="roleFilter" class="form-select form-select-lg">
                    <option value="all" selected>Все роли</option>
                    @foreach (var role in roleOptions)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0" id="usersTable" style="min-width: 300px;">
            <thead class="table-light text-secondary">
                <tr>
                    <th>Полное имя</th>
                    <th>Телефон</th>
                    <th>Роль</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr data-name="@user.FullName.ToLower()" data-phone="@user.PhoneNumber" data-role="@user.Role">
                        <td data-label="Полное имя" class="fw-semibold text-dark">@user.FullName</td>
                        <td data-label="Телефон" class="text-muted">@user.PhoneNumber</td>
                        <td data-label="Роль">
                            <span class="badge bg-info text-dark text-uppercase fw-semibold" style="letter-spacing: 0.05em;">
                                @user.Role
                            </span>
                        </td>
                        <td data-label="Действия" class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-2" title="Редактировать сотрудника">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Удалить пользователя @user.FullName?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить сотрудника">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('search');
            const role = document.getElementById('roleFilter');
            const rows = Array.from(document.querySelectorAll('#usersTable tbody tr'));

            function apply() {
                const q = (search?.value || '').trim().toLowerCase();
                const r = role?.value || 'all';
                rows.forEach(row => {
                    const matchesText = !q || row.dataset.name.includes(q) || row.dataset.phone.includes(q);
                    const matchesRole = r === 'all' || (row.dataset.role || '') === r;
                    row.style.display = (matchesText && matchesRole) ? '' : 'none';
                });
            }
            search?.addEventListener('input', apply);
            role?.addEventListener('change', apply);
            apply();
        })();
    </script>
}
