@model List<Restaurant.ViewModels.EditEmployeeViewModel>
@{
    ViewData["Title"] = "Сотрудники";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">👤 Сотрудники</h2>
        <a asp-action="Create" class="btn btn-success">➕ Добавить сотрудника</a>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1">
                <label class="form-label">Поиск</label>
                <input id="search" type="text" class="form-control" placeholder="Имя или телефон..." />
            </div>
            <div>
                <label class="form-label">Роль</label>
                <select id="roleFilter" class="form-select">
                    <option value="all" selected>Все</option>
                    <option value="Admin">Admin</option>
                    <option value="Manager">Manager</option>
                    <option value="Cashier">Cashier</option>
                </select>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th>Полное имя</th>
                    <th>Телефон</th>
                    <th>Роль</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr data-name="@user.FullName.ToLower()" data-phone="@user.PhoneNumber" data-role="@user.Role">
                        <td>@user.FullName</td>
                        <td>@user.PhoneNumber</td>
                        <td><span class="badge bg-secondary">@user.Role</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">✏️ Редактировать</a>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Удалить пользователя @user.FullName?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const search = document.getElementById('search');
            const role = document.getElementById('roleFilter');
            const rows = Array.from(document.querySelectorAll('#usersTable tbody tr'));
            function apply(){
                const q = (search?.value || '').trim().toLowerCase();
                const r = role?.value || 'all';
                rows.forEach(row => {
                    const matchesText = !q || row.dataset.name.includes(q) || row.dataset.phone.includes(q);
                    const matchesRole = r === 'all' || (row.dataset.role || '') === r;
                    row.style.display = (matchesText && matchesRole) ? '' : 'none';
                });
            }
            search?.addEventListener('input', apply);
            role?.addEventListener('change', apply);
            apply();
        })();
    </script>
}
