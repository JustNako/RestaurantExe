@model Restaurant.Entities.Reservation
@{
    ViewData["Title"] = "Редактировать бронирование";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var tables = ViewBag.Tables as List<Restaurant.Entities.Table> ?? new List<Restaurant.Entities.Table>();
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4>Редактировать бронирование</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="TableId" class="form-label">Стол *</label>
                        <select asp-for="TableId" class="form-select" required>
                            <option value="">Выберите стол</option>
                            @foreach (var table in tables)
                            {
                                <option value="@table.Id" selected="@(Model.TableId == table.Id)">Стол №@table.Number</option>
                            }
                        </select>
                        <span asp-validation-for="TableId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReservationTime" class="form-label">Дата и время бронирования *</label>
                        <input asp-for="ReservationTime" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="ReservationTime" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EndTime" class="form-label">Время окончания</label>
                        <input asp-for="EndTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label">Имя клиента *</label>
                        <input asp-for="CustomerName" class="form-control" required maxlength="200" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerPhone" class="form-label">Телефон клиента *</label>
                        <input asp-for="CustomerPhone" class="form-control" required maxlength="50" />
                        <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Статус</label>
                        <select asp-for="Status" class="form-select">
                            <option value="@Restaurant.Entities.ReservationStatus.Active">Активно</option>
                            <option value="@Restaurant.Entities.ReservationStatus.Completed">Завершено</option>
                            <option value="@Restaurant.Entities.ReservationStatus.Cancelled">Отменено</option>
                            <option value="@Restaurant.Entities.ReservationStatus.NoShow">Не пришел</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Примечания</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="500"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Сохранить
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

