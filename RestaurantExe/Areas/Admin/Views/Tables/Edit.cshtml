@model Restaurant.Entities.Table
@{
    ViewData["Title"] = "Изменить стол";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>✏️ Изменить стол</h2>

<form asp-action="Edit" method="post" class="w-50">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Номер стола</label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsOccupied" class="form-check-input" />
        <label class="form-check-label">Занят</label>
    </div>
    <button asp-action="Dashboard" type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Dashboard" class="btn btn-secondary">Назад</a>
</form>
