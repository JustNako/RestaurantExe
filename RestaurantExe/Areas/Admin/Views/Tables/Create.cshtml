@model Restaurant.Entities.Table
@{
    ViewData["Title"] = "Create Table";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>➕ Add Table</h2>

<form asp-action="Create" method="post" class="w-50">
    <div class="mb-3">
        <label asp-for="Number" class="form-label"></label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsOccupied" class="form-check-input" />
        <label asp-for="IsOccupied" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
