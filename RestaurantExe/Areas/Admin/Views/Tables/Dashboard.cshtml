@model List<Restaurant.Entities.Table>
@{
    ViewData["Title"] = "Статус столов";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .tables-dashboard {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .dashboard-header {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            text-align: center;
        }

        .dashboard-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }

        .dashboard-subtitle {
            font-size: 1.2rem;
            color: #666;
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            min-width: 150px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9rem;
        }

        .filters { display:flex; gap:10px; justify-content:center; flex-wrap: wrap; margin-top: 10px; }
        .filters .btn { border-radius: 999px; }
        .search-box { border:2px solid #e9ecef; border-radius: 10px; padding: 8px 12px; }
        .tables-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 20px; }

        .table-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: visible;
            cursor: pointer;
            user-select: none;
            min-height: 200px;
        }

        .table-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .table-card:active {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

        .table-card.actions-active {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            z-index: 10;
        }

        .table-card.free {
            border-left: 5px solid #28a745;
        }

        .table-card.occupied {
            border-left: 5px solid #dc3545;
        }

        .table-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 15px;
            text-align: center;
        }

        .table-status {
            text-align: center;
            margin-bottom: 20px;
        }

        .status-badge {
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 1rem;
        }

        .status-free {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
        }

        .status-occupied {
            background: linear-gradient(135deg, #dc3545, #fd7e14);
            color: white;
        }

        .table-actions {
            display: flex;
            gap: 8px;
            justify-content: center;
            flex-wrap: wrap;
            transition: all 0.3s ease;
            opacity: 0;
            transform: translateY(10px);
            margin-top: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            backdrop-filter: blur(10px);
        }

        .btn-table {
            padding: 6px 12px;
            border-radius: 15px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            font-size: 0.85rem;
            min-width: 80px;
        }

        .btn-create-order {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
        }

        .btn-create-order:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 123, 255, 0.3);
            color: white;
        }

        .btn-edit {
            background: linear-gradient(135deg, #ffc107, #e0a800);
            color: #212529;
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
            color: #212529;
        }

        .btn-delete {
            background: linear-gradient(135deg, #dc3545, #fd7e14);
            color: white;
        }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
            color: white;
        }

        .btn-qr {
            background: linear-gradient(135deg, #6f42c1, #e83e8c);
            color: white;
        }

        .btn-qr:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(111, 66, 193, 0.3);
            color: white;
        }

        .actions-row {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin-bottom: 8px;
        }

        .actions-row:last-child {
            margin-bottom: 0;
        }

        .refresh-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            border: none;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
        }

        .refresh-btn:hover {
            transform: rotate(180deg) scale(1.1);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }

        .no-tables {
            background: white;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .no-tables-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: white;
            border-radius: 20px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            animation: modalSlideIn 0.3s ease;
        }

        @@keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .modal-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .modal-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 25px;
        }

        .btn-modal {
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-cancel {
            background: #6c757d;
            color: white;
        }

        .btn-cancel:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

        .btn-save {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
        }

        @@media (max-width: 768px) {
            .tables-grid {
                grid-template-columns: 1fr;
            }
            
            .stats-container {
                flex-direction: column;
                align-items: center;
            }
            
            .dashboard-title {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="tables-dashboard">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1050; min-width: 300px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1050; min-width: 300px;">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <div class="dashboard-header">
        <h1 class="dashboard-title">Статус столов</h1>
        <p class="dashboard-subtitle">Мониторинг занятости столов в реальном времени</p>
        
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-number" style="color: #28a745;">@Model.Count(t => !t.IsOccupied)</div>
                <div class="stat-label">🟢 Свободно</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #dc3545;">@Model.Count(t => t.IsOccupied)</div>
                <div class="stat-label">🔴 Занято</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #007bff;">@Model.Count</div>
                <div class="stat-label">📊 Всего</div>
            </div>
        </div>
        
        <div class="filters">
            <div class="input-group" style="max-width: 340px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input id="tableSearch" type="text" class="form-control search-box" placeholder="Поиск по номеру стола..." />
            </div>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-secondary active" data-filter="all">Все</button>
                <button type="button" class="btn btn-outline-success" data-filter="free">Свободные</button>
                <button type="button" class="btn btn-outline-danger" data-filter="occupied">Занятые</button>
            </div>
        </div>

        <div class="text-center mt-3">
            <p class="text-muted mb-3">💡 Нажмите на карточку стола, чтобы увидеть доступные действия</p>
            <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Create">
                <button class="btn btn-success btn-lg" onclick="showAddTableForm()">
                    ➕ Добавить новый стол
                </button>
            </permission>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="no-tables">
            <div class="no-tables-icon">🪑</div>
            <h3>Столы не найдены</h3>
            <p>Добавьте столы для начала работы</p>
            <button class="btn btn-success" onclick="showAddTableForm()">➕ Добавить стол</button>
        </div>
    }
    else
    {
        <div class="tables-grid">
            @foreach (var table in Model.OrderBy(t => t.Number))
            {
                        <div class="table-card @(table.IsOccupied ? "occupied" : "free")" data-number="@table.Number" data-status="@(table.IsOccupied ? "occupied" : "free")" onclick="toggleTableActions(this, event)">
            <div class="table-number">Стол №@table.Number</div>
            
            <div class="table-status">
                @if (table.IsOccupied)
                {
                    <span class="status-badge status-occupied">🔴 Занят</span>
                }
                else
                {
                    <span class="status-badge status-free">🟢 Свободен</span>
                }
            </div>
            
            <div class="table-actions" style="display: none;">
                <div class="actions-row">

                    @if (!table.IsOccupied)
                    {
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Create">
                            <a asp-controller="Orders" asp-action="Create" asp-route-tableId="@table.Id" 
                               class="btn-table btn-create-order">
                                ➕ Заказ
                            </a>
                        </permission>
                    }
                    else
                    {
                        <span class="btn-table btn-create-order" style="opacity: 0.5; cursor: not-allowed;">
                            ⏳ Занят
                        </span>
                    }
                    
                    <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Edit">
                        <a asp-action="Edit" asp-route-id="@table.Id" 
                           class="btn-table btn-edit">
                            ✏️ Редактировать
                        </a>
                    </permission>
                </div>
                
                <div class="actions-row">
                    <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Delete">
                        <a asp-action="Delete" asp-route-id="@table.Id"
                           class="btn-table btn-delete">
                            🗑️ Удалить
                        </a>
                    </permission>

                    <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.View">
                        <a asp-controller="Qr" asp-action="ShowTableQr" asp-route-tableId="@table.Id"
                           class="btn-table btn-qr">
                            📱 QR
                        </a>
                    </permission>
                </div>
            </div>
                </div>
            }
        </div>
    }

    <button class="refresh-btn" onclick="location.reload()" title="Обновить статус">
        🔄
    </button>
</div>

<!-- Модальное окно для добавления стола -->
<div id="addTableModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title"><i class="fa-solid fa-table"></i> Добавить новый стол</h2>
            <p>Введите номер нового стола</p>
        </div>
        
        <form id="addTableForm" asp-area="Admin" asp-controller="Tables" asp-action="Create" method="post">
            <div class="form-group">
                <label for="tableNumber" class="form-label">Номер стола</label>
                <input type="text" id="tableNumber" name="Number" class="form-control" 
                       placeholder="Например: 1, 2, 3..." required>
            </div>
            
            <div class="modal-actions">
                <button type="button" class="btn-modal btn-cancel" onclick="hideAddTableForm()">
                    ❌ Отмена
                </button>
                <button type="submit" class="btn-modal btn-save">
                    ✅ Добавить стол
                </button>                
            </div>
        </form>
    </div>
</div>

<script>
        document.addEventListener('DOMContentLoaded', function() {
        // Список номеров столов из модели
        const existingTableNumbers = Array.from(document.querySelectorAll('.table-card'))
            .map(card => card.dataset.number.toLowerCase());

        const addTableForm = document.getElementById('addTableForm');
        const tableNumberInput = document.getElementById('tableNumber');

        addTableForm.addEventListener('submit', function(e) {
            const newNumber = tableNumberInput.value.trim().toLowerCase();
            if (!newNumber) {
                alert('Пожалуйста, введите номер стола');
                e.preventDefault();
                return;
            }

            if (existingTableNumbers.includes(newNumber)) {
                alert(`Стол с номером "${tableNumberInput.value.trim()}" уже существует!`);
                e.preventDefault();
            }
        });
    });


    // Функции для работы с модальным окном
    function showAddTableForm() {
        const modal = document.getElementById('addTableModal');
        modal.style.display = 'flex';
        document.getElementById('tableNumber').focus();
    }

    function hideAddTableForm() {
        const modal = document.getElementById('addTableModal');
        modal.style.display = 'none';
        document.getElementById('addTableForm').reset();
    }

    // Закрытие модального окна при клике вне его
    document.getElementById('addTableModal').addEventListener('click', function(e) {
        if (e.target === this) {
            hideAddTableForm();
        }
    });

    // Обработка отправки формы
    document.getElementById('addTableForm').addEventListener('submit', function(e) {
        const tableNumber = document.getElementById('tableNumber').value.trim();
        if (!tableNumber) {
            e.preventDefault();
            alert('Пожалуйста, введите номер стола');
            return;
        }
    });

    // Фильтры и поиск
    (function(){
        const buttons = document.querySelectorAll('.filters [data-filter]');
        const search = document.getElementById('tableSearch');
        const cards = Array.from(document.querySelectorAll('.table-card'));
        let active = 'all';

        function apply(){
            const q = (search?.value || '').trim().toLowerCase();
            cards.forEach(c => {
                const matchesFilter = active === 'all' || c.dataset.status === active;
                const matchesSearch = !q || (c.dataset.number || '').toString().toLowerCase().includes(q);
                c.style.display = (matchesFilter && matchesSearch) ? '' : 'none';
            });
        }
        buttons.forEach(b => b.addEventListener('click', () => {
            buttons.forEach(x => x.classList.remove('active'));
            b.classList.add('active');
            active = b.dataset.filter;
            apply();
        }));
        if (search) search.addEventListener('input', apply);
        apply();
    })();

    // Автообновление каждые 45 секунд (плавнее)
    setInterval(function() { location.reload(); }, 45000);

    // Функция для переключения Actions
    function toggleTableActions(card, event) {
        // Если кликнули на кнопку, не переключаем Actions
        if (event.target.closest('.table-actions')) {
            return;
        }
        
        const actions = card.querySelector('.table-actions');
        const allActions = document.querySelectorAll('.table-actions');
        
        // Скрываем все другие Actions
        allActions.forEach(action => {
            if (action !== actions) {
                action.style.display = 'none';
                action.style.opacity = '0';
                action.style.transform = 'translateY(10px)';
            }
        });
        
        // Переключаем текущие Actions
        if (actions.style.display === 'none') {
            // Показываем Actions
            actions.style.display = 'flex';
            actions.style.opacity = '0';
            actions.style.transform = 'translateY(10px)';
            
            // Анимация появления
            setTimeout(() => {
                actions.style.transition = 'all 0.3s ease';
                actions.style.opacity = '1';
                actions.style.transform = 'translateY(0)';
            }, 10);
            
            // Добавляем активный класс к карточке
            card.classList.add('actions-active');
        } else {
            // Скрываем Actions
            actions.style.transition = 'all 0.3s ease';
            actions.style.opacity = '0';
            actions.style.transform = 'translateY(10px)';
            
            setTimeout(() => {
                actions.style.display = 'none';
            }, 300);
            
            // Убираем активный класс
            card.classList.remove('actions-active');
        }
    }

    // Анимация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.table-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                card.style.transition = 'all 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });
</script>
