@model List<Restaurant.Entities.Shift>
@{
    ViewData["Title"] = "Смены";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">⏱️ Смены</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-success" asp-action="Open">🟢 Открыть смену</a>
            <a class="btn btn-danger" asp-action="Close">🔴 Закрыть смену</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @{
            var active = Model.FirstOrDefault(s => s.ClosedAt == null);
        }
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                    @if (active != null)
                    {
                        <div>
                            <div class="text-muted">Активная смена</div>
                            <div class="fw-semibold">Открыта: @active.OpenedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            <div class="small">Кассир: @active.OpenedBy</div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted">Наличные при открытии</div>
                            <div class="fw-semibold">@($"{active.OpeningCash:N2} ₸")</div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Сейчас нет активной смены.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">История смен</h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Открыта</th>
                            <th>Закрыта</th>
                            <th>Кассир (откр.)</th>
                            <th class="text-end">Нал. при откр.</th>
                            <th class="text-end">Нал. при закр.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model)
                        {
                            <tr>
                                <td>@shift.Id</td>
                                <td>@shift.OpenedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(shift.ClosedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>@shift.OpenedBy</td>
                                <td class="text-end">@($"{shift.OpeningCash:N2} ₸")</td>
                                <td class="text-end">@($"{(shift.ClosingCash ?? 0m):N2} ₸")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
