@model Restaurant.Entities.Shift
@{
    ViewData["Title"] = "Закрытие смены";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-2">
    <h2 class="mb-3">🔴 Закрытие смены</h2>

    <div class="card shadow-sm mb-3" style="max-width: 640px;">
        <div class="card-body d-flex justify-content-between flex-wrap gap-2">
            <div>
                <div class="text-muted">Смена открыта</div>
                <div class="fw-semibold">@Model.OpenedAt.ToString("dd.MM.yyyy HH:mm")</div>
                <div class="small">Кассир: @Model.OpenedBy</div>
            </div>
            <div class="text-end">
                <div class="text-muted">Наличные при открытии</div>
                <div class="fw-semibold">@($"{Model.OpeningCash:N2} ₸")</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm" style="max-width: 640px;">
        <div class="card-body">
            <form asp-action="Close" method="post">
                <div class="mb-3">
                    <label class="form-label">💰 Остаток в кассе при закрытии</label>
                    <input name="closingCash" type="number" class="form-control" step="0.01" min="0" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">📝 Служебная запись (необязательно)</label>
                    <textarea name="noteText" class="form-control" rows="3" placeholder="Комментарий к закрытию смены"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Закрыть смену</button>
                    <a asp-action="Index" class="btn btn-secondary">Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>
