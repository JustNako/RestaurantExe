@{
    ViewData["Title"] = "Открытие смены";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-2">
    <h2 class="mb-3">🟢 Открытие смены</h2>
    <div class="card shadow-sm" style="max-width: 480px;">
        <div class="card-body">
            <form asp-action="Open" method="post">
                <div class="mb-3">
                    <label class="form-label">💵 Наличные в кассе на открытие</label>
                    <input name="openingCash" type="number" class="form-control" step="0.01" min="0" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Открыть смену</button>
                    <a asp-action="Index" class="btn btn-secondary">Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>
