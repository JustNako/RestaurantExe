@model Restaurant.ViewModels.ZReportViewModel
@{
    ViewData["Title"] = "Z-отчёт по смене";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">🧾 Z-отчёт</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" onclick="window.print()">🖨️ Печать</button>
            <a asp-action="Index" class="btn btn-secondary">⬅ Назад</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Смена</h6>
                    <div class="mt-2">
                        <div><span class="text-muted">Начало:</span> <strong>@Model.ShiftStart.ToString("dd.MM.yyyy HH:mm")</strong></div>
                        <div><span class="text-muted">Конец:</span> <strong>@Model.ShiftEnd.ToString("dd.MM.yyyy HH:mm")</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Итоги продаж</h6>
                    <div class="row text-center mt-2">
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Общая выручка</div>
                            <div class="fs-5">@($"{Model.TotalRevenue:N2} ₸")</div>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Заказы</div>
                            <div class="fs-5">@Model.TotalOrders</div>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Наличные</div>
                            <div class="fs-5 text-success">@($"{Model.CashPayments + Model.MixedCashPayments:N2} ₸")</div>
                            <small class="text-muted">(в т.ч. смеш.: @($"{Model.MixedCashPayments:N2} ₸"))</small>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Картой</div>
                            <div class="fs-5 text-primary">@($"{Model.CardPayments + Model.MixedCardPayments:N2} ₸")</div>
                            <small class="text-muted">(в т.ч. смеш.: @($"{Model.MixedCardPayments:N2} ₸"))</small>
                        </div>
                        <div class="col-12 mt-2">
                            <div class="fw-semibold">Смешанные оплаты</div>
                            <div class="fs-5 text-info">@($"{Model.MixedTotalPayments:N2} ₸")</div>
                            <small class="text-muted">Наличные @($"{Model.MixedCashPayments:N2} ₸") + Картой @($"{Model.MixedCardPayments:N2} ₸")</small>
                        </div>

                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <div class="text-muted">Скидки / возвраты</div>
                        <div class="fw-semibold">@($"{Model.TotalDiscounts:N2} ₸")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Служебные записи</h6>
                    @if (Model.Notes != null && Model.Notes.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var note in Model.Notes)
                            {
                                <li class="list-group-item">@note</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted">Нет служебных действий за эту смену.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>