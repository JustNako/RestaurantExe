@model List<Restaurant.Entities.Order>
@{
    ViewData["Title"] = "Ежедневный отчёт";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var total = Model?.Sum(o => o.Items.Sum(i => i.Price * i.Quantity) - o.Discount) ?? 0m;
    var avg = (Model != null && Model.Count > 0) ? total / Model.Count : 0m;
    var targetDate = ViewBag.Date ?? DateTime.Today;

    var cash = (Model?.Sum(o => o.PaidCash) ?? 0m)
               + (Model?.Where(o => o.PaymentType == Restaurant.Entities.PaymentType.Cash && o.PaidCash == 0m)
                         .Sum(o => o.Items.Sum(i => i.Price * i.Quantity) - o.Discount) ?? 0m);

    var card = (Model?.Sum(o => o.PaidCard) ?? 0m)
               + (Model?.Where(o => o.PaymentType == Restaurant.Entities.PaymentType.Card && o.PaidCard == 0m)
                         .Sum(o => o.Items.Sum(i => i.Price * i.Quantity) - o.Discount) ?? 0m);

    var online = Model?.Where(o => o.PaymentType == Restaurant.Entities.PaymentType.Online)
        .Sum(o => o.Items.Sum(i => i.Price * i.Quantity) - o.Discount) ?? 0m;

    var mixedCash = Model?.Where(o => o.PaymentType == Restaurant.Entities.PaymentType.Mixed)
        .Sum(o => o.PaidCash) ?? 0m;

    var mixedCard = Model?.Where(o => o.PaymentType == Restaurant.Entities.PaymentType.Mixed)
        .Sum(o => o.PaidCard) ?? 0m;

    var mixedTotal = mixedCash + mixedCard;
    var totalDiscounts = Model?.Sum(o => o.Discount) ?? 0m;

    var top = (Model ?? new List<Restaurant.Entities.Order>())
        .SelectMany(o => o.Items)
        .GroupBy(i => i.ProductId)
        .Select(g => new
        {
            ProductId = g.Key,
            Qty = g.Sum(x => x.Quantity),
            Revenue = g.Sum(x => x.Quantity * x.Price),
            Name = g.First().Product?.Name
        })
        .OrderByDescending(x => x.Revenue)
        .Take(10)
        .ToList();
}

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-area, .print-area * {
            visibility: visible;
        }

        .print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 58mm;
            font-family: 'Courier New', monospace;
            font-size: 10pt;
            line-height: 1.2;
        }

        .no-print {
            display: none !important;
        }
    }

    .receipt {
        width: 58mm;
        max-width: 58mm;
        margin: 0 auto;
        font-family: 'Courier New', monospace;
        font-size: 10pt;
        line-height: 1.2;
        padding: 5mm;
    }

    .receipt-header {
        text-align: center;
        margin-bottom: 5mm;
        border-bottom: 1px dashed #000;
        padding-bottom: 3mm;
    }

    .receipt-line {
        border-top: 1px dashed #000;
        margin: 2mm 0;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        margin: 1mm 0;
    }

    .receipt-center {
        text-align: center;
    }

    .receipt-right {
        text-align: right;
    }
</style>

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">📅 Ежедневный отчёт</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Печать</button>
            <a asp-action="Index" class="btn btn-secondary">⬅ Назад</a>
        </div>
    </div>

    <!-- Печатная версия -->
    <div class="print-area receipt">
        <div class="receipt-header">
            <div style="font-weight: bold; font-size: 12pt;">РЕСТОРАН</div>
            <div style="font-size: 9pt;">ЕЖЕДНЕВНЫЙ ОТЧЕТ</div>
            <div style="font-size: 8pt;">@targetDate.ToString("dd.MM.yyyy")</div>
            <div style="font-size: 8pt;">@DateTime.Now.ToString("HH:mm:ss")</div>
        </div>

        <div class="receipt-line"></div>

        <div class="receipt-row">
            <span>Заказов:</span>
            <span style="font-weight: bold;">@Model?.Count()</span>
        </div>

        <div class="receipt-row">
            <span>Выручка:</span>
            <span style="font-weight: bold;">@($"{total:N2}") ₸</span>
        </div>

        <div class="receipt-row">
            <span>Средний чек:</span>
            <span style="font-weight: bold;">@($"{avg:N2}") ₸</span>
        </div>

        <div class="receipt-row">
            <span>Скидки:</span>
            <span style="font-weight: bold;">@($"{totalDiscounts:N2}") ₸</span>
        </div>

        <div class="receipt-line"></div>

        <div style="font-weight: bold; margin-top: 3mm; margin-bottom: 2mm;">ОПЛАТА:</div>

        <div class="receipt-row">
            <span>Наличные:</span>
            <span>@($"{cash:N2}") ₸</span>
        </div>
        @if (mixedCash > 0)
        {
            <div class="receipt-row" style="padding-left: 5mm; font-size: 9pt;">
                <span>в т.ч. смешанные:</span>
                <span>@($"{mixedCash:N2}") ₸</span>
            </div>
        }

        <div class="receipt-row">
            <span>Картой:</span>
            <span>@($"{card:N2}") ₸</span>
        </div>
        @if (mixedCard > 0)
        {
            <div class="receipt-row" style="padding-left: 5mm; font-size: 9pt;">
                <span>в т.ч. смешанные:</span>
                <span>@($"{mixedCard:N2}") ₸</span>
            </div>
        }

        @if (online > 0)
        {
            <div class="receipt-row">
                <span>Онлайн:</span>
                <span>@($"{online:N2}") ₸</span>
            </div>
        }

        <div class="receipt-line"></div>

        <div style="font-weight: bold; margin-top: 3mm; margin-bottom: 2mm;">ТОП ТОВАРЫ:</div>

        @if (top.Any())
        {
            @foreach (var item in top)
            {
                <div style="margin: 1mm 0;">
                    <div style="font-size: 9pt;">@(item.Name?.Length > 20 ? item.Name.Substring(0, 20) + "..." : item.Name)</div>
                    <div class="receipt-row" style="font-size: 9pt;">
                        <span>@item.Qty шт. x @($"{item.Revenue / item.Qty:N2}")</span>
                        <span>@($"{item.Revenue:N2}") ₸</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="font-size: 9pt; color: #999;">Нет данных по товарам</div>
        }

        <div class="receipt-line"></div>

        <div class="receipt-center" style="margin-top: 5mm; font-size: 8pt;">
            <div>================================</div>
            <div style="margin-top: 2mm;">Отчет сформирован</div>
            <div>@DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</div>
            <div style="margin-top: 3mm;">================================</div>
        </div>
    </div>

    <div class="no-print"></div>

    <div class="row g-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Заказы</div>
                            <div class="fs-5">@Model?.Count()</div>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Выручка</div>
                            <div class="fs-5">@($"{total:N2} ₸")</div>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Средний чек</div>
                            <div class="fs-5">@($"{avg:N2} ₸")</div>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <div class="fw-semibold">Скидки</div>
                            <div class="fs-5 text-danger">@($"{totalDiscounts:N2} ₸")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-3">Разбивка по типам оплаты</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Наличные <small class="text-muted">(в т.ч. смеш.: @($"{mixedCash:N2} ₸"))</small></span>
                            <strong>@($"{cash:N2} ₸")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Картой <small class="text-muted">(в т.ч. смеш.: @($"{mixedCard:N2} ₸"))</small></span>
                            <strong>@($"{card:N2} ₸")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Онлайн</span>
                            <strong>@($"{online:N2} ₸")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Смешанные оплаты</span>
                            <strong>@($"{mixedTotal:N2} ₸")</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-3">Топ-товары</h6>
                    @if (top.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Товар</th>
                                        <th class="text-end">Кол-во</th>
                                        <th class="text-end">Выручка</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var x in top)
                                    {
                                        <tr>
                                            <td>@x.Name</td>
                                            <td class="text-end">@x.Qty</td>
                                            <td class="text-end">@($"{x.Revenue:N2} ₸")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Нет данных по товарам за выбранную дату.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Список заказов</h6>
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive fs-7">
                            <table class="table table-striped table-hover align-middle table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th class="d-none d-md-table-cell ps-1 pe-1">#</th>
                                        <th class="pe-1">Дата</th>
                                        <th class="d-none d-sm-table-cell pe-1">Стол</th>
                                        <th class="text-end pe-2">Сумма</th>
                                        <th class="pe-1">Оплата</th>
                                        <th class="text-end pe-1 d-none d-md-table-cell">Скидка</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in Model.OrderByDescending(x => x.CreatedAt))
                                    {
                                        var sum = o.Items.Sum(i => i.Price * i.Quantity);
                                        var finalAmount = sum - o.Discount;
                                        string paymentType = o.PaymentType switch
                                        {
                                            Restaurant.Entities.PaymentType.Cash => "Наличные",
                                            Restaurant.Entities.PaymentType.Card => "Картой",
                                            Restaurant.Entities.PaymentType.Mixed => "Смешанная",
                                            _ => o.PaymentType.ToString()
                                        };

                                        string paymentDetails = "";
                                        if (o.PaymentType == Restaurant.Entities.PaymentType.Mixed)
                                        {
                                            paymentDetails = $"Нал.: {o.PaidCash:N0} ₸, Карта: {o.PaidCard:N0} ₸";
                                        }
                                        else if (o.PaymentType == Restaurant.Entities.PaymentType.Cash)
                                        {
                                            paymentDetails = $"Нал.: {(o.PaidCash > 0 ? o.PaidCash : finalAmount):N0} ₸";
                                        }
                                        else if (o.PaymentType == Restaurant.Entities.PaymentType.Card)
                                        {
                                            paymentDetails = $"Карта: {(o.PaidCard > 0 ? o.PaidCard : finalAmount):N0} ₸";
                                        }
                                        <tr>
                                            <td class="d-none d-md-table-cell ps-1 pe-1">@o.Id</td>
                                            <td class="pe-1 text-nowrap small">@o.CreatedAt.ToString("dd.MM HH:mm")</td>
                                            <td class="d-none d-sm-table-cell pe-1 small">@(o.Table?.Number ?? "-")</td>
                                            <td class="text-end pe-2 fw-bold small">@($"{finalAmount:N0} ₸")</td>
                                            <td class="pe-1">
                                                <div class="small">@paymentType</div>
                                                @if (!string.IsNullOrEmpty(paymentDetails))
                                                {
                                                    <div class="text-muted small d-none d-md-block">@paymentDetails</div>
                                                }
                                            </td>
                                            <td class="text-end pe-1 d-none d-md-table-cell @(o.Discount > 0 ? "text-danger" : "") small">
                                                @if (o.Discount > 0)
                                                {
                                                    @($"{o.Discount:N0} ₸")
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Заказы за выбранную дату не найдены.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
