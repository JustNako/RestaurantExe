@using Restaurant.Entities
@model Restaurant.ViewModels.OrdersIndexViewModel

@{
    ViewData["Title"] = "Список заказов";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .orders-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e0e0e0 100%);
            min-height: 100vh;
            padding: 20px;
            color: #222;
        }

        .orders-header {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            text-align: center;
            color: #222;
        }

        .orders-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 10px;
        }

        .orders-subtitle {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 25px;
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: #fefefe;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.07);
            min-width: 150px;
            color: #333;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9rem;
        }

        .actions-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .btn-create {
            background: linear-gradient(135deg, #333 0%, #000 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.5);
                color: white;
            }

        .filter-section {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .form-select {
            border: 2px solid #ccc;
            border-radius: 20px;
            padding: 8px 15px;
            font-weight: 500;
            transition: all 0.3s ease;
            background: white;
            color: #222;
        }

            .form-select:focus {
                outline: none;
                border-color: #555;
                box-shadow: 0 0 0 3px rgba(85,85,85,0.2);
            }

        .btn-filter {
            background: linear-gradient(135deg, #555, #222);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-filter:hover {
                transform: translateY(-1px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            }

        .orders-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .order-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            color: #222;
        }

            .order-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

            .order-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(135deg, #555, #222);
            }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .order-id {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111;
        }

        .order-status {
            padding: 6px 15px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            color: white;
        }

        .status-new {
            background: linear-gradient(135deg, #666, #444);
        }

        .status-completed {
            background: linear-gradient(135deg, #222, #000);
        }

        .status-cancelled {
            background: linear-gradient(135deg, #800000, #400000);
        }

        .order-info {
            margin-bottom: 20px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #f1f1f1;
            color: #333;
        }

        .info-label {
            font-weight: 600;
            color: #444;
        }

        .info-value {
            color: #222;
            font-weight: 500;
        }

        .order-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            font-size: 0.9rem;
            color: white;
        }

        .btn-view {
            background: linear-gradient(135deg, #555, #222);
        }

            .btn-view:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                color: white;
            }

        .btn-edit {
            background: linear-gradient(135deg, #999, #666);
            color: #fff;
        }

            .btn-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(150,150,150,0.3);
                color: #fff;
            }

        .btn-cancel {
            background: linear-gradient(135deg, #800000, #400000);
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(128,0,0,0.5);
                color: white;
            }

        .no-orders {
            background: white;
            border-radius: 20px;
            padding: 50px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            color: #222;
        }

        .no-orders-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .tip-section {
            background: #f0f0f0;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 5px solid #444;
        }

        .tip-text {
            color: #444;
            font-weight: 500;
            margin: 0;
        }

        .tip-link {
            color: #222;
            text-decoration: none;
            font-weight: 600;
        }

            .tip-link:hover {
                text-decoration: underline;
            }

        @@media (max-width: 768px) {
            .orders-grid

        {
            grid-template-columns: 1fr;
        }

        .stats-container {
            flex-direction: column;
            align-items: center;
        }

        .orders-title {
            font-size: 2rem;
        }

        .actions-section {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
            width: 100%;
        }

            .actions-section .btn-create,
            .actions-section .tip-section,
            .actions-section .filter-section {
                width: 100%;
                max-width: none;
                box-sizing: border-box;
            }

            .actions-section .btn-create {
                padding: 12px 20px;
                font-size: 0.95rem;
            }

            .actions-section .filter-section {
                justify-content: center;
                flex-wrap: wrap;
            }

            .actions-section .form-select,
            .actions-section .btn-filter {
                width: auto;
                min-width: 120px;
                flex: 1 1 auto;
            }

        }

        @@media (max-width: 400px) {
            .actions-section .btn-create

        {
            padding: 10px 15px;
            font-size: 0.85rem;
        }

        .actions-section .form-select,
        .actions-section .btn-filter {
            min-width: 100px;
            font-size: 0.85rem;
            padding: 6px 10px;
        }

        .stat-number {
            font-size: 1.5rem;
        }

        }
    </style>
}


<div class="orders-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1050; min-width: 300px;">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="orders-header">
        <h1 class="orders-title"><i class="bi bi-list-nested"></i> Список заказов</h1>
        <p class="orders-subtitle">Управление заказами ресторана</p>
        
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-number" style="color: #6c757d;">@Model.NewCount</div>
                <div class="stat-label">🆕 Новые</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #28a745;">@Model.CompletedCount</div>
                <div class="stat-label">✅ Завершённые</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #dc3545;">@Model.CancelledCount</div>
                <div class="stat-label">❌ Отменённые</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" style="color: #007bff;">@Model.TotalCount</div>
                <div class="stat-label">📊 Всего</div>
            </div>
        </div>

        <div class="actions-section">
            <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Create">
                <a asp-action="Create" class="btn-create">
                    ➕ Новый заказ
                </a>
            </permission>
            
            <div class="tip-section">
                <p class="tip-text">
                    💡 Завершение заказов происходит в разделе 
                    <a asp-area="Admin" asp-controller="Cashier" asp-action="Index" class="tip-link">"Касса"</a>
                </p>
            </div>

            <form method="get" class="filter-section">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">Все статусы</option>
                    <option value="New" selected="@("New" == Model.SelectedStatus?.ToString())">🆕 Новые</option>
                    <option value="Completed" selected="@("Completed" == Model.SelectedStatus?.ToString())">✅ Завершённые</option>
                    <option value="Cancelled" selected="@("Cancelled" == Model.SelectedStatus?.ToString())">❌ Отменённые</option>
                </select>
                <button type="submit" class="btn-filter">🔍 Фильтр</button>
            </form>
        </div>
    </div>

    @if (!Model.Orders.Any())
    {
        <div class="no-orders">
            <div class="no-orders-icon">📦</div>
            <h3>Заказов пока нет</h3>
            <p>Создайте первый заказ для начала работы</p>
            <a asp-action="Create" class="btn-create">➕ Создать заказ</a>
        </div>
    }
    else
    {
        <div class="orders-grid">
            @foreach (var order in Model.Orders)
            {
                <div class="order-card">
                    <div class="order-header">
                        <div class="order-id">Заказ #@order.Id</div>
                        <span class="order-status @($"status-{order.Status.ToString().ToLower()}")">
                            @if (order.Status == OrderStatus.New)
                            {
                                <span>🆕 Новый</span>
                            }
                            else if (order.Status == OrderStatus.Completed)
                            {
                                <span>✅ Завершён</span>
                            }
                            else if (order.Status == OrderStatus.Cancelled)
                            {
                                <span>❌ Отменён</span>
                            }
                        </span>
                    </div>
                    
                    <div class="order-info">
                        <div class="info-row">
                            @if (order.Place == Place.DineIn && order.Table?.IsDeleted == true)
                            {
                                <span class="info-label text-danger">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Удалённый стол:
                                </span>
                                <span class="info-value text-danger">
                                    №@order.Table.Number
                                </span>
                            }
                            else if (order.Place == Place.DineIn && order.Table != null)
                            {
                                <span class="info-label">
                                    <i class="fa-solid fa-table"></i> Стол:
                                </span>
                                <span class="info-value">
                                    №@order.Table.Number
                                </span>
                            }
                            else if (order.Place == Place.Delivery)
                            {
                                <span class="info-label"><i class="fa-solid fa-truck"></i> Доставка</span>
                            }
                            else if (order.Place == Place.Takeaway)
                            {
                                <span class="info-label"><i class="fa-solid fa-box"></i> С собой</span>
                            }                            
                            else
                            {
                                <span class="info-label"><i class="fa-solid fa-question"></i> Без стола</span>
                            }
                        </div>

                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-calendar-event-fill"></i> Дата:</span>
                            <span class="info-value"><span data-datetime="@order.CreatedAt.ToUniversalTime().ToString("o")" data-format="short">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label"><i class="bi bi-cash-stack"></i> Сумма:</span>
                            <span class="info-value">@order.TotalAmount.ToString("0.00") ₸</span>
                        </div>
                    </div>
                    
                    <div class="order-actions">
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.View">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn-action btn-view">
                                👁 Просмотр
                            </a>
                        </permission>
                        <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Edit">
                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn-action btn-edit">
                                <i class="bi bi-pen"></i> Редактировать
                            </a>
                        </permission>
                        @if (order.Status == OrderStatus.New)
                        {
                            <permission asp-permission="@Restaurant.Authorization.Permissions.Orders.Delete">
                                <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="d-inline">
                                    <button class="btn-action btn-cancel" onclick="return confirm('Отменить этот заказ?')">
                                        🚫 Отменить
                                    </button>
                                </form>
                            </permission>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Orders pagination">
                <ul class="pagination">
                    @{ var prevDisabled = Model.Page <= 1 ? " disabled" : string.Empty; }
                    <li class="page-item@prevDisabled">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.SelectedStatus">«</a>
                    </li>

                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        var active = p == Model.Page ? " active" : string.Empty;
                        <li class="page-item@active">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.SelectedStatus">@p</a>
                        </li>
                    }

                    @{ var nextDisabled = Model.Page >= Model.TotalPages ? " disabled" : string.Empty; }
                    <li class="page-item@nextDisabled">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.SelectedStatus">»</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<script>
    // Анимация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.order-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                card.style.transition = 'all 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });
</script>
