@using Restaurant.Entities
@model List<Restaurant.Entities.Order>
@{
    ViewData["Title"] = "Касса";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4"><i class="bi bi-wallet-fill"></i> Открытые заказы</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Нет открытых заказов</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var order in Model)
        {
            var total = order.Items?.Sum(i => i.Quantity * i.Price) ?? 0m;
            <div class="col">
                <div class="card h-100 shadow">
                    <div class="card-body">
                        <h5 class="card-title">
                            @if (order.Place == Place.DineIn && order.Table != null)
                            {
                                <text>Стол №@order.Table.Number</text>
                            }
                            else
                            {
                                @switch (order.Place)
                                {
                                    case Place.Takeaway:
                                        <text>С собой</text>
                                        break;
                                    case Place.Delivery:
                                        <text>Доставка</text>
                                        break;
                                    default:
                                        <text>Без стола</text>
                                        break;
                                }
                            }
                        </h5>

                        <ul class="list-group mb-3">
                            @foreach (var item in order.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.Product.Name (@item.Quantity)</span>
                                    <span>@(item.Price* item.Quantity) ₸</span>
                                </li>
                            }
                        </ul>
                        <h5>💰 Общая сумма: <strong>@order.TotalAmount₸</strong></h5>
                        <a asp-action="CloseOrder" asp-route-id="@order.Id" class="btn btn-primary">Закрыть</a>


                    </div>
                </div>

            </div>

        }

    </div>
    
}
<a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-secondary">Назад</a>
