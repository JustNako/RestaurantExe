@model Restaurant.Entities.Order
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Чек #" + Model.Id;
}

<style>
    /* ====== BASE LAYOUT (SCREEN ONLY) ====== */
    .receipt-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 20px;
    }

    .receipt-preview {
        font-family: "Courier New", monospace;
        font-size: 10pt;
        line-height: 1.25;
        padding: 18px;
        width: 100%;
        max-width: 58mm;
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 6px;
        margin: 0 auto;
    }

    .receipt-header {
        text-align: center;
        margin-bottom: 10px;
        border-bottom: 1px dashed #000;
        padding-bottom: 6px;
    }

    .receipt-line {
        border-top: 1px dashed #000;
        margin: 6px 0;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        margin: 3px 0;
    }

    .receipt-item {
        margin: 4px 0;
    }

    .receipt-item-name {
        font-size: 9pt;
        margin-bottom: 1px;
        word-break: break-word;
    }

    .receipt-item-details {
        display: flex;
        justify-content: space-between;
        font-size: 9pt;
        padding-left: 3mm;
    }

    /* ====== BUTTONS ====== */
    .print-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 20px;
    }

    .btn-print {
        padding: 10px 26px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid #ccc;
        background: linear-gradient(180deg, #ffffff, #e6e6e6);
        cursor: pointer;
        transition: 0.2s ease;
    }

    .btn-print:hover {
        background: #dcdcdc;
    }

    .btn-secondary-link {
        padding: 10px 26px;
        text-decoration: none;
        background: #f8f9fa;
        border: 1px solid #ccc;
        border-radius: 8px;
        color: #333;
        font-weight: 600;
    }

    .btn-secondary-link:hover {
        background: #e9ecef;
    }

    /* ====== PRINT MODE ====== */
    @@media print {
        body * {
            visibility: hidden !important;
        }

        #receiptContent, #receiptContent * {
            visibility: visible !important;
        }

        #receiptContent {
            position: absolute;
            left: 0;
            top: 0;
            width: 58mm;
            border: none !important;
            box-shadow: none !important;
            padding: 0;
            margin: 0;
        }

        .print-actions,
        .alert,
        h2 {
            display: none !important;
        }

        body {
            background: white !important;
        }
    }
</style>

<div class="receipt-container">

    <h2 class="mb-3">🧾 Чек #@Model.Id</h2>

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert" style="max-width: 600px; width: 100%;">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="receipt-preview" id="receiptContent">

        <!-- HEADER -->
        <div class="receipt-header">
            <div style="font-weight: bold; font-size: 11pt;">РЕСТОРАН</div>
            <div style="font-size: 9pt;">КАССОВЫЙ ЧЕК</div>
            <div style="font-size: 8pt;">№ @Model.Id</div>
            <div style="font-size: 8pt;">@DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</div>
        </div>

        <div class="receipt-row">
            <span>Стол:</span>
            <span>@Model.Table?.Number</span>
        </div>

        <div class="receipt-line"></div>

        <div style="font-weight: bold; margin-bottom: 4px;">ТОВАРЫ</div>

        @foreach (var item in Model.Items)
        {
            <div class="receipt-item">
                <div class="receipt-item-name">@item.Product?.Name</div>
                <div class="receipt-item-details">
                    <span>@item.Quantity × @(item.Price.ToString("N2"))</span>
                    <span>@((item.Price * item.Quantity).ToString("N2")) ₸</span>
                </div>
            </div>
        }

        <div class="receipt-line"></div>

        @{
            var subtotal = Model.Items.Sum(i => i.Price * i.Quantity);
            var finalAmount = subtotal - Model.Discount;
        }

        <div class="receipt-row">
            <span>Подытог:</span>
            <span>@subtotal.ToString("N2") ₸</span>
        </div>

        @if (Model.Discount > 0)
        {
            <div class="receipt-row">
                <span>Скидка:</span>
                <span>-@Model.Discount.ToString("N2") ₸</span>
            </div>
        }

        <div class="receipt-row" style="font-weight: bold; font-size: 11pt; margin-top: 4px;">
            <span>ИТОГО:</span>
            <span>@finalAmount.ToString("N2") ₸</span>
        </div>

        <div class="receipt-line"></div>

        <div>
            <span style="font-size: 9pt; font-weight: bold;">Оплата:</span>

            <div style="font-size: 9pt; margin-top: 2px;">
                @{
                    if (Model.PaymentType == Restaurant.Entities.PaymentType.Cash)
                    {
                        @($"Наличные: {finalAmount:N2} ₸")
                    }
                    else if (Model.PaymentType == Restaurant.Entities.PaymentType.Card)
                    {
                        @($"Карта: {finalAmount:N2} ₸")
                    }
                    else if (Model.PaymentType == Restaurant.Entities.PaymentType.Online)
                    {
                        @($"Онлайн: {finalAmount:N2} ₸")
                    }
                    else if (Model.PaymentType == Restaurant.Entities.PaymentType.Mixed)
                    {
                        @($"Наличные: {Model.PaidCash:N2} ₸")
                        <br />
                        @($"Карта: {Model.PaidCard:N2} ₸")
                    }
                }
            </div>
        </div>

        <div class="receipt-line"></div>

        <div class="receipt-center" style="text-align:center; font-size: 8pt; margin-top: 6px;">
            Спасибо за визит!
        </div>

    </div>

    <div class="print-actions">
        <button class="btn-print" onclick="window.print()"><i class="bi bi-printer"></i> Печать чека</button>
        <a asp-action="Index" class="btn-secondary-link">Закрыть</a>
    </div>
</div>
