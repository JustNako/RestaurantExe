@{
    ViewData["Title"] = "Приход на склад";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var ing = (Restaurant.Entities.Ingredient)ViewBag.Ingredient;
}

<h2>➕ Приход: @ing.Name</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Количество (@ing.Unit)</label>
        <input name="quantity" type="number" step="0.01" min="0.01" class="form-control" required />
        <span class="text-muted">Текущий остаток: @ing.CurrentQuantity @ing.Unit</span>
    </div>
    <div class="mb-3">
        <label class="form-label">Комментарий</label>
        <input name="reason" class="form-control" />
    </div>
    <div class="mt-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        <button type="submit" class="btn btn-primary">Добавить</button>
    </div>
    @Html.ValidationSummary(false, "", new { @class = "text-danger mt-2" })
</form>






