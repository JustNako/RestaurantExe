@model Restaurant.Entities.Ingredient
@{
    ViewData["Title"] = "Новый ингредиент";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>➕ Новый ингредиент</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Название</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Единица (g, kg, ml, l, pcs)</label>
        <input asp-for="Unit" class="form-control" />
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Текущий остаток</label>
            <input asp-for="CurrentQuantity" class="form-control" type="number" step="0.01" value="0" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Минимальный остаток</label>
            <input asp-for="MinimumQuantity" class="form-control" type="number" step="0.01" value="0" />
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        <button type="submit" class="btn btn-success">Сохранить</button>
    </div>
    @Html.ValidationSummary(false, "", new { @class = "text-danger mt-2" })
 </form>






