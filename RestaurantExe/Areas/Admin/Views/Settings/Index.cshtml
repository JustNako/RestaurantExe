@model Restaurant.Entities.Settings

@{
    ViewData["Title"] = "Настройки POS";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="fa-solid fa-gear me-2"></i>
            <h5 class="mb-0">Общие настройки POS системы</h5>
        </div>

        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fa-solid fa-check"></i>
                    @TempData["Success"]
                </div>
            }

            <form method="post">
                <div class="row">
                    <!-- Название ресторана -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="RestaurantName" class="form-label">
                            <i class="fa-solid fa-store"></i>
                            Название ресторана
                        </label>
                        <input asp-for="RestaurantName"
                               class="form-control"
                               placeholder="Введите название ресторана" />
                        <span asp-validation-for="RestaurantName" class="text-danger"></span>
                    </div>

                    <!-- Процент обслуживания -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ServiceChargePercentage" class="form-label">
                            <i class="fa-solid fa-percent"></i>
                            Процент обслуживания
                        </label>
                        <div class="input-group">
                            <input asp-for="ServiceChargePercentage"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="100" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="ServiceChargePercentage" class="text-danger"></span>
                        <small class="text-muted">
                            Используется для автоматического расчёта сервиса в заказах
                        </small>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa-solid fa-save"></i>
                        Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
