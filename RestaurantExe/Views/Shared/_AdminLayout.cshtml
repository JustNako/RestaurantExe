<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">




    @RenderSection("Styles", required: false)

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            background-attachment: fixed;
        }

        .sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1f3a 0%, #2d3561 100%);
            color: white;
            flex-shrink: 0;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow-y: auto;
        }

        .sidebar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea, #764ba2, #f093fb);
            background-size: 200% 100%;
            animation: gradientShift 3s ease infinite;
        }

        @@keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .sidebar h4 {
            font-weight: 700;
            font-size: 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 2rem;
            padding-top: 1.5rem;
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            padding: 12px 20px;
            margin: 4px 12px;
            border-radius: 12px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            font-weight: 500;
            position: relative;
            overflow: hidden;
        }

        .sidebar .nav-link::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: linear-gradient(180deg, #667eea, #764ba2);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .sidebar .nav-link:hover {
            background: rgba(102, 126, 234, 0.15);
            color: white;
            transform: translateX(5px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        .sidebar .nav-link:hover::before {
            transform: scaleY(1);
        }

        .sidebar .nav-link.active {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(118, 75, 162, 0.3) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .sidebar .nav-link.active::before {
            transform: scaleY(1);
        }

        .sidebar .nav-link i {
            font-size: 1.2rem;
            margin-right: 12px;
            width: 24px;
            text-align: center;
        }

        .main-content {
            flex-grow: 1;
            padding: 40px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            margin: 20px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            min-height: calc(100vh - 40px);
        }

        .main-content h2 {
            font-weight: 700;
            font-size: 2rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1.5rem;
        }

        .main-content hr {
            border: none;
            height: 3px;
            background: linear-gradient(90deg, #667eea, #764ba2);
            border-radius: 2px;
            margin-bottom: 2rem;
        }

        .btn {
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        }

        .btn-outline-light {
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.5);
        }

        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        }

        .table {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .form-control, .form-select {
            border-radius: 12px;
            border: 2px solid #e0e0e0;
            padding: 12px 16px;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .alert {
            border-radius: 16px;
            border: none;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            backdrop-filter: blur(10px);
            animation: slideInRight 0.5s ease;
        }

        @@keyframes gradientShift {
            0%, 100%

        {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        }

        body {
            min-height: 100vh;
            display: flex;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            background-attachment: fixed;
        }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1f3a 0%, #2d3561 100%);
            color: white;
            flex-shrink: 0;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow-y: auto;
            transition: all 0.3s ease;
        }

            .sidebar::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #667eea, #764ba2, #f093fb);
                background-size: 200% 100%;
                animation: gradientShift 3s ease infinite;
            }

        /* Mobile styles */
        @@media (max-width: 992px) {
            .sidebar

        {
            position: fixed;
            top: 0;
            left: -300px; /* скрыто */
            height: 100%;
            z-index: 1500;
        }

        .sidebar.active {
            left: 0;
            box-shadow: 4px 0 20px rgba(0,0,0,0.5);
        }

        /* Затемнение фона */
        #overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1400;
        }

            #overlay.active {
                display: block;
            }


        }

        #burgerBtn {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0; /* убрать лишние паддинги */
            color: black;
            background: #fbf1f1c2;
        }


        #closeSidebar {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0;
        }

            #closeSidebar i {
                font-size: 1.5rem; /* можно увеличить до 1.8-2rem, если надо */
                line-height: 1;
                vertical-align: middle;
            }


        }</style>
</head>
<body>
    <!-- Burger Button -->
    <button id="burgerBtn" class="btn btn-primary d-lg-none"
            style="position: fixed; top: 20px; left: 20px; z-index: 2000; border-radius: 50%; width: 50px; height: 50px;">
        <i class="bi bi-list" style="font-size: 1.5rem;"></i>
    </button>

    <div id="overlay"></div>


    <!-- Sidebar -->
    <div class="sidebar d-flex flex-column p-3">


        <h4 class="text-white mb-4">Restaurant Admin</h4>
        <ul class="nav nav-pills flex-column mb-auto">
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Users.Manage))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Employees" asp-action="Index">
                        <i class="bi bi-people me-2"></i>Пользователи
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Roles.Manage))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-shield-lock me-2"></i>Роли
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Categories.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-folder me-2"></i>Категории
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Orders.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Tables" asp-action="Dashboard">
                        <i class="bi-table me-2"></i>Столы
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Cash.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Cashier" asp-action="Index">
                        <i class="bi-cash-stack me-2"></i>Касса
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Orders.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <i class="bi-card-list me-2"></i>Заказы
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Orders.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Qr" asp-action="Index">
                        <i class="bi-qr-code me-2"></i>QR коды
                    </a>
                </li>
            }
            <!--@if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Inventory.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Inventory" asp-action="Index">📦 Склад</a>
                </li>
            }-->
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Shifts.Open) || 
                 User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Shifts.Close))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Shift" asp-action="Index">
                        <i class="bi-clock-history me-2"></i>Смены
                    </a>
                </li>
            }
            @if (User.HasClaim(Restaurant.Authorization.Permissions.ClaimType, Restaurant.Authorization.Permissions.Reports.View))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                        <i class="bi-bar-chart-line me-2"></i>Отчет
                    </a>
                </li>
            }
            <li class="nav-item mt-3">
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light w-100">Выйти</button>
                </form>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1050; min-width: 300px;">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert" style="position: fixed; top: 80px; right: 20px; z-index: 1050; min-width: 300px;">
                @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <h2>@ViewData["Title"]</h2>
        <hr />
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <!-- Временно убираем inputmask для тестирования -->
    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.8/jquery.inputmask.min.js"></script> -->

    <script>
        $(document).ready(function () {
            // $(".phone-mask").inputmask({
            //     mask: "+7 (999) 999-99-99",
            //     placeholder: "_",
            //     showMaskOnHover: false,
            //     showMaskOnFocus: true,
            //     autoUnmask: false,
            //     clearIncomplete: false,
            //     // Защищает от удаления +7
            //     prefix: "+7 ",
            //     definitions: {
            //         '9': {
            //             validator: "[0-9]",
            //             cardinality: 1
            //         }
            //     }
            // });
        });

        const burgerBtn = document.getElementById("burgerBtn");
        const sidebar = document.querySelector(".sidebar");
        const overlay = document.getElementById("overlay");
        const closeSidebar = document.getElementById("closeSidebar");

        burgerBtn.addEventListener("click", () => {
        sidebar.classList.toggle("active");
        overlay.classList.toggle("active");
        });

        overlay.addEventListener("click", () => {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        });

    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
