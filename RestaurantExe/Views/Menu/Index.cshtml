@model List<Restaurant.Entities.Category>
@{
    ViewData["Title"] = "Меню";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tableNumber = ViewData["TableNumber"] as string;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@section Styles {
    <style>
        /* === Общие стили === */
        :root {
            --primary: #6a0dad;
            --primary-light: #8e44ad;
            --primary-dark: #4b0582;
            --bg: #fafafa;
            --card-bg: #ffffff;
            --text: #2d2d2d;
            --text-muted: #7a7a7a;
            --border: #eaeaea;
            --shadow: 0 2px 12px rgba(0,0,0,0.04);
            --radius: 16px;
            --transition: all 0.25s cubic-bezier(0.33, 0, 0.67, 0.33);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.5;
            padding-bottom: calc(70px + env(safe-area-inset-bottom));
            overflow-x: hidden;
        }

        .page-content {
            padding-top: 110px;
            padding-bottom: 20px;
            min-height: 100vh;
        }

        /* === Шапка (фиксированная) === */
        .header-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: var(--card-bg);
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            max-width: 768px;
            margin: 0 auto;
        }

        .header-title {
            font-weight: 600;
            font-size: 1.25rem;
            color: var(--text);
        }

        .menu-toggle, .search-toggle {
            background: none;
            border: none;
            font-size: 1.3rem;
            color: var(--text);
            cursor: pointer;
            padding: 6px;
            border-radius: 50%;
            transition: var(--transition);
        }

            .menu-toggle:hover, .search-toggle:hover {
                background: #f0f0f0;
            }

        /* === Поиск === */
        .search-container {
            margin-top: 10px;
            padding: 0 20px;
            max-width: 768px;
            margin: 0 auto;
        }

        .search-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: #f8f8f8;
            font-size: 1rem;
            outline: none;
            transition: background 0.2s;
        }

            .search-input:focus {
                background: white;
                border-color: var(--primary);
                box-shadow: 0 0 0 2px rgba(106, 13, 173, 0.15);
            }

        /* === Категории === */
        .categories {
            display: flex;
            overflow-x: auto;
            gap: 8px;
            padding: 16px 20px 12px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .categories::-webkit-scrollbar {
                display: none;
            }

        .category-tab {
            white-space: nowrap;
            padding: 8px 16px;
            border-radius: 20px;
            background: #f0f0f0;
            border: none;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition);
        }

            .category-tab:hover {
                background: #e5e5e5;
            }

            .category-tab.active {
                background: var(--primary);
                color: white;
            }

        /* === Сетка продуктов === */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            padding: 0 16px;
            padding-bottom: 80px;
            padding-top: 10px;
            max-width: 768px;
            margin: 0 auto;
        }

        .product-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform 0.3s ease;
            height: auto;
        }

            .product-card:hover {
                transform: translateY(-4px);
            }

        .product-image-container {
            position: relative;
            width: 100%;
            height: 0;
            padding-bottom: 100%; /* 1:1 */
            overflow: hidden;
            background: #f6f6f6;
        }

        .product-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: opacity 0.3s ease;
        }

        .labels {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            gap: 6px;
            z-index: 2;
        }

        .label {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
            text-transform: uppercase;
        }

            .label.new {
                background: var(--primary);
            }

            .label.hit {
                background: #e74c3c;
            }

            .label.top {
                background: #3498db;
            }

        .product-info {
            padding: 14px;
        }

        .product-name {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 6px;
            line-height: 1.3;
            min-height: 40px;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .product-price {
            font-size: 1rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .add-to-cart {
            width: 100%;
            padding: 10px;
            background: #f0f0f0;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            color: var(--text);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: var(--transition);
        }

            .add-to-cart:hover {
                background: #e5e5e5;
            }

            .add-to-cart:active {
                transform: scale(0.98);
            }

        /* === Нижняя панель === */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 70px;
            background: var(--card-bg);
            display: flex;
            justify-content: center;
            align-items: center;
            border-top: 1px solid var(--border);
            padding-bottom: env(safe-area-inset-bottom);
            z-index: 1100;
        }

        .cart-btn {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 0 10px;
            font-size: 0.8rem;
            color: var(--text-muted);
            background: none;
            border: none;
            cursor: pointer;
        }

            .cart-btn.active, .cart-btn:hover {
                color: var(--primary);
            }

        .cart-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #e74c3c;
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: scale(0.5);
            transition: var(--transition);
        }

            .cart-badge.show {
                opacity: 1;
                transform: scale(1);
            }

        /* === Корзина (modal-style снизу) === */
        #cart-sidebar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            max-width: 500px;
            margin: 0 auto;
            background: white;
            border-radius: 24px 24px 0 0;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.15);
            z-index: 2000;
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }

            #cart-sidebar.open {
                transform: translateY(0);
            }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid var(--border);
        }

        .cart-title {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .btn-close {
            background: none;
            border: none;
            font-size: 1.4rem;
            color: var(--text-muted);
            cursor: pointer;
            padding: 6px;
            border-radius: 50%;
            transition: var(--transition);
        }

            .btn-close:hover {
                color: var(--text);
                background: #f5f5f5;
            }

        .cart-items {
            flex: 1;
            overflow-y: auto;
            padding: 0 20px 20px;
        }

        .cart-item {
            display: flex;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--border);
        }

            .cart-item:last-child {
                border-bottom: none;
            }

        .cart-item-img {
            width: 72px;
            height: 72px;
            border-radius: 12px;
            object-fit: cover;
            background: #f6f6f6;
        }

        .cart-item-details {
            flex: 1;
        }

        .cart-item-name {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .cart-item-price {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .qty-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qty-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #f0f0f0;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

            .qty-btn:hover {
                background: #e0e0e0;
            }

        .qty-input {
            width: 40px;
            text-align: center;
            border: none;
            background: transparent;
            font-weight: 600;
            outline: none;
        }

        .delete-btn {
            margin-left: auto;
            background: none;
            border: none;
            color: #e74c3c;
            font-size: 1.2rem;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            transition: var(--transition);
        }

            .delete-btn:hover {
                background: #fdf2f2;
            }

        .cart-total {
            padding: 16px 20px;
            font-size: 1.25rem;
            font-weight: 700;
            text-align: right;
            color: var(--text);
            border-top: 1px solid var(--border);
            margin-top: auto;
        }

        #cart-submit {
            width: 90%;
            padding: 16px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin: 0 20px 20px;
        }

            #cart-submit:hover:not(:disabled) {
                background: var(--primary-dark);
            }

            #cart-submit:disabled {
                background: #c5c5c5;
                cursor: not-allowed;
            }

        /* === Вспомогательные === */
        .no-results {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .empty-cart {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }
    </style>
}

<!-- === Основной контент === -->
<div class="page-content">
    <div class="header-wrapper">
        <div class="header">
            <button class="menu-toggle"><i class="bi bi-list"></i></button>
            <h1 class="header-title">Меню</h1>
            <button class="search-toggle"><i class="bi bi-search"></i></button>
        </div>
        <div class="search-container d-none">
            <input type="text" class="search-input" placeholder="Название блюда..." autocomplete="off" />
        </div>
        <div class="categories" role="tablist">
            <button class="category-tab active" data-category="all">Все</button>
            @foreach (var category in Model)
            {
                <button class="category-tab" data-category="@category.Id">@category.Name</button>
            }
        </div>
    </div>

    <div class="product-grid" role="list">
        @if (Model.Any(c => c.Products.Any()))
        {
            @foreach (var category in Model)
            {
                @foreach (var product in category.Products)
                {
                    <div class="product-card" data-category="@category.Id" data-product-id="@product.Id" role="listitem">
                        <div class="product-image-container">
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@product.ImagePath" alt="@product.Name" class="product-image" loading="lazy" />
                            }
                            else
                            {
                                <div class="product-image d-flex align-items-center justify-content-center" style="background:#f6f6f6;color:#ccc;font-size:2rem;">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                            @* Можно добавить лейблы динамически, если есть *@
                            @* <div class="labels">
                                <span class="label new">Новинка</span>
                            </div> *@
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">@product.Name</h3>
                            <div class="product-price">
                                @product.Price.ToString("N0", new System.Globalization.CultureInfo("kk-KZ")) ₸
                            </div>
                            <button class="add-to-cart" type="button">
                                <i class="bi bi-plus-circle"></i> В корзину
                            </button>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <p class="no-results">Меню временно пусто</p>
        }
    </div>
</div>

<!-- Нижняя панель -->
<nav class="bottom-nav">
    <button id="cart-toggle" class="cart-btn">
        <i class="bi bi-cart"></i>
        <span>Корзина</span>
        <span id="cart-count" class="cart-badge">0</span>
    </button>
</nav>

<!-- Корзина -->
<div id="cart-sidebar" aria-hidden="true">
    <div class="cart-header">
        <h2 class="cart-title">Ваш заказ</h2>
        <button id="cart-close" class="btn-close"><i class="bi bi-x-lg"></i></button>
    </div>
    <div id="cart-items" class="cart-items"></div>
    <div id="cart-total" class="cart-total">Итого: 0 ₸</div>
    <button id="cart-submit" disabled>Отправить заказ</button>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            const tabs = document.querySelectorAll('.category-tab');
            const products = document.querySelectorAll('.product-card');
            let currentCategory = 'all';
            let cart = new Map();

            // === Фильтрация ===
            function filterProducts(searchQuery = '') {
                const query = searchQuery.trim().toLowerCase();
                let visible = 0;

                products.forEach(card => {
                    const cat = card.dataset.category;
                    const name = card.querySelector('.product-name').textContent.toLowerCase();
                    const matchesCat = currentCategory === 'all' || cat === currentCategory;
                    const matchesSearch = !query || name.includes(query);

                    if (matchesCat && matchesSearch) {
                        card.style.display = 'block';
                        visible++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Показать/скрыть "Ничего не найдено"
                const grid = document.querySelector('.product-grid');
                const noResults = grid.querySelector('.no-results');
                if (visible === 0 && !noResults) {
                    grid.innerHTML = '<p class="no-results">Товаров не найдено</p>';
                } else if (visible > 0 && noResults) {
                    grid.innerHTML = '';
                    // Пересоздаём сетку (можно оптимизировать, но для простоты — так)
                    location.reload(); // ⚠️ или лучше сделать append через JS — но это уже сложнее
                }
            }

            // Переключение вкладок
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    currentCategory = tab.dataset.category;
                    filterProducts(document.querySelector('.search-input')?.value || '');
                });
            });

            // Поиск
            const searchToggle = document.querySelector('.search-toggle');
            const searchContainer = document.querySelector('.search-container');
            const searchInput = document.querySelector('.search-input');

            searchToggle?.addEventListener('click', () => {
                searchContainer.classList.toggle('d-none');
                if (!searchContainer.classList.contains('d-none')) {
                    searchInput.focus();
                } else {
                    searchInput.value = '';
                    filterProducts('');
                }
            });

            searchInput?.addEventListener('input', e => filterProducts(e.target.value));

            // === Корзина ===
            function updateCartCount() {
                const countEl = document.getElementById('cart-count');
                const total = Array.from(cart.values()).reduce((s, v) => s + v.quantity, 0);
                if (total > 0) {
                    countEl.textContent = total;
                    countEl.classList.add('show');
                } else {
                    countEl.classList.remove('show');
                }
            }

            function renderCart() {
                const itemsEl = document.getElementById('cart-items');
                const totalEl = document.getElementById('cart-total');
                const submitBtn = document.getElementById('cart-submit');

                if (cart.size === 0) {
                    itemsEl.innerHTML = '<p class="empty-cart">Корзина пуста</p>';
                    totalEl.textContent = 'Итого: 0 ₸';
                    submitBtn.disabled = true;
                    return;
                }

                let html = '';
                let total = 0;

                cart.forEach(({ product, quantity }) => {
                    const itemTotal = product.Price * quantity;
                    total += itemTotal;
                    html += `
                        <div class="cart-item" data-product-id="${product.Id}">
                            <img src="${product.ImagePath || '/images/placeholder.png'}"
                                 alt="${product.Name}" class="cart-item-img">
                            <div class="cart-item-details">
                                <div class="cart-item-name">${product.Name}</div>
                                <div class="cart-item-price">${(product.Price).toLocaleString('kk-KZ')} ₸ × ${quantity}</div>
                                <div class="qty-controls">
                                    <button class="qty-btn minus">−</button>
                                    <input type="text" class="qty-input" value="${quantity}" inputmode="numeric">
                                    <button class="qty-btn plus">+</button>
                                    <button class="delete-btn" title="Удалить"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    `;
                });

                itemsEl.innerHTML = html;
                totalEl.textContent = `Итого: ${total.toLocaleString('kk-KZ')} ₸`;
                submitBtn.disabled = false;
            }

            function addToCart(productId) {
                const card = document.querySelector(`.product-card[data-product-id="${productId}"]`);
                if (!card) return;

                const product = {
                    Id: productId,
                    Name: card.querySelector('.product-name').textContent,
                    Price: parseFloat(card.querySelector('.product-price').textContent.replace(/\s|₸/g, '')) || 0,
                    ImagePath: card.querySelector('.product-image')?.src
                };

                if (cart.has(productId)) {
                    cart.get(productId).quantity++;
                } else {
                    cart.set(productId, { product, quantity: 1 });
                }

                updateCartCount();
                renderCart();
            }

            // Добавление в корзину
            document.querySelectorAll('.add-to-cart').forEach(btn => {
                btn.addEventListener('click', e => {
                    const card = e.target.closest('.product-card');
                    addToCart(card.dataset.productId);
                });
            });

            // Открытие/закрытие корзины
            const cartToggle = document.getElementById('cart-toggle');
            const cartSidebar = document.getElementById('cart-sidebar');
            const cartClose = document.getElementById('cart-close');

            cartToggle.addEventListener('click', () => cartSidebar.classList.add('open'));
            cartClose.addEventListener('click', () => cartSidebar.classList.remove('open'));
            cartSidebar.addEventListener('click', e => {
                if (e.target === cartSidebar) cartSidebar.classList.remove('open');
            });

            // Управление количеством в корзине
                    // Управление количеством в корзине (FIX)
            document.getElementById('cart-items').addEventListener('click', e => {
                const item = e.target.closest('.cart-item');
                if (!item) return;

                const id = item.dataset.productId;
                if (!cart.has(id)) return;

                if (e.target.closest('.minus')) {
                    let qty = cart.get(id).quantity - 1;
                    if (qty < 1) {
                        cart.delete(id);
                    } else {
                        cart.get(id).quantity = qty;
                    }
                }
                else if (e.target.closest('.plus')) {
                    cart.get(id).quantity++;
                }
                else if (e.target.closest('.delete-btn')) {
                    cart.delete(id);
                }

                updateCartCount();
                renderCart();
            });


            document.getElementById('cart-items').addEventListener('input', e => {
                if (e.target.classList.contains('qty-input')) {
                    const item = e.target.closest('.cart-item');
                    const id = item.dataset.productId;
                    let val = parseInt(e.target.value) || 1;
                    if (val < 1) val = 1;
                    if (cart.has(id)) {
                        cart.get(id).quantity = val;
                        updateCartCount();
                        renderCart();
                    }
                }
            });

            // Отправка заказа
            document.getElementById('cart-submit').addEventListener('click', async () => {
                if (cart.size === 0) return;

                const items = Array.from(cart.values()).map(({ product, quantity }) => ({
                    ProductId: product.Id,
                    Name: product.Name,
                    Price: product.Price,
                    Quantity: quantity,
                    ImagePath: product.ImagePath
                }));

                const payload = {
                    qrCode: "@ViewData["QrCode"]",
                    items: items
                };

                try {
                    const res = await fetch('/Menu/SubmitOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();

                    if (data.success) {
                        alert('✅ Заказ отправлен!');
                        cart.clear();
                        updateCartCount();
                        renderCart();
                        cartSidebar.classList.remove('open');
                    } else {
                        alert('❌ Ошибка: ' + (data.message || 'Не удалось отправить заказ'));
                    }
                } catch (err) {
                    console.error(err);
                    alert('⚠️ Ошибка сети. Попробуйте позже.');
                }
            });

            // Инициализация
            updateCartCount();
            renderCart();
        });
    </script>
}