@model List<Restaurant.Entities.Category>
@{
    ViewData["Title"] = "Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tableNumber = ViewData["TableNumber"] as string;
}

@section Styles {
    <style>
        /* Общие стили */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f9f9fb;
            margin: 0;
            padding: 0;
            color: #222;
        }

        /* Центрируем контейнер, максимальная ширина для ПК */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px 40px;
        }

        /* Заголовок меню */
        .menu-header {
            text-align: center;
            padding: 40px 20px 30px;
            background: linear-gradient(135deg, #563d7c, #8b5fbf);
            color: white;
            border-radius: 0 0 30px 30px;
            box-shadow: 0 4px 20px rgba(86, 61, 124, 0.4);
        }

        .menu-title {
            font-size: 2.8rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .menu-subtitle {
            font-size: 1.1rem;
            opacity: 0.85;
        }

        /* Категории */
        .category-title {
            font-size: 1.8rem;
            font-weight: 700;
            border-bottom: 4px solid #8b5fbf;
            padding-bottom: 10px;
            margin-top: 50px;
            margin-bottom: 25px;
            color: #3b2e5a;
        }

        /* Сетка продуктов */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        /* Карточка продукта */
        .product-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 16px rgb(0 0 0 / 0.08);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 25px rgb(86 61 124 / 0.3);
            }

        .product-image {
            height: 160px;
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
            background-color: #f7f6fb;
            border-bottom: 1px solid #eee;
        }

        .product-image-placeholder {
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #aaa;
            font-size: 0.95rem;
            border-bottom: 1px solid #eee;
        }

        .product-info {
            padding: 15px 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .product-name {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #2a1a4d;
            min-height: 48px;
        }

        .product-description {
            font-size: 0.85rem;
            color: #666;
            flex-grow: 1;
            line-height: 1.3;
            margin-bottom: 15px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-price {
            font-size: 1.2rem;
            font-weight: 900;
            color: #663399;
        }

        .btn-add-to-cart {
            background: #663399;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
            user-select: none;
        }

            .btn-add-to-cart:hover {
                background-color: #512c91;
            }

            .btn-add-to-cart:active {
                transform: scale(0.96);
            }

        /* Корзина — кнопка */
        #cart-toggle {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: linear-gradient(135deg, #663399, #8b5fbf);
            border: none;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            padding: 14px 22px;
            border-radius: 50px;
            box-shadow: 0 8px 20px rgba(102, 51, 153, 0.45);
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
            z-index: 1100;
            transition: background-color 0.3s ease;
        }

            #cart-toggle:hover {
                background-color: #512c91;
            }

            #cart-toggle:active {
                transform: scale(0.95);
            }

        /* Счётчик */
        #cart-count {
            background: #e83e8c;
            color: white;
            font-weight: 900;
            font-size: 0.85rem;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Боковая панель корзины */
        #cart-sidebar {
            position: fixed;
            bottom: 0;
            right: 0;
            width: 380px;
            max-width: 90vw;
            height: 80vh;
            background: white;
            border-radius: 20px 0 0 0;
            box-shadow: 0 -8px 30px rgba(86, 61, 124, 0.35);
            padding: 25px 30px;
            z-index: 1050;
            overflow-y: auto;
            display: none;
            flex-direction: column;
            transition: transform 0.3s ease;
        }

            /* Отображение панели */
            #cart-sidebar.open {
                display: flex;
            }

            /* Заголовок корзины */
            #cart-sidebar h4 {
                margin: 0 0 20px 0;
                font-size: 1.5rem;
                color: #3b2e5a;
                font-weight: 700;
            }

        /* Элементы корзины */
        #cart-items {
            flex-grow: 1;
            overflow-y: auto;
        }

        /* Итого */
        #cart-total {
            font-size: 1.2rem;
            font-weight: 700;
            color: #222;
            padding: 15px;
            border-top: 2px solid #eee;
            margin-top: 15px;
            text-align: right;
        }

        /* Кнопки внизу */
        #cart-submit {
            width: 100%;
            background: #28a745;
            border: none;
            color: white;
            font-weight: 700;
            padding: 16px 0;
            border-radius: 12px;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 15px;
            transition: background-color 0.3s ease;
        }

            #cart-submit:hover {
                background-color: #218838;
            }

            #cart-submit:active {
                transform: scale(0.97);
            }

        #cart-close {
            width: 100%;
            background: transparent;
            border: none;
            color: #666;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 10px;
        }

        /* Элемент корзины */
        .cart-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px;
            background: #fafafa;
            border-radius: 12px;
            margin-bottom: 12px;
        }

            .cart-item img {
                width: 56px;
                height: 56px;
                object-fit: cover;
                border-radius: 8px;
            }

        .cart-item-details {
            flex-grow: 1;
            min-width: 0;
        }

        .cart-item-name {
            font-weight: 700;
            font-size: 1rem;
            color: #3b2e5a;
        }

        .cart-item-price {
            font-size: 0.9rem;
            color: #777;
            margin-top: 5px;
        }

        .cart-qty-input {
            width: 60px;
            padding: 6px;
            border: 1px solid #ccc;
            border-radius: 8px;
            text-align: center;
            font-size: 1rem;
        }

        /* Мобильные стили */
        @@media (max-width: 767px) {
            .container

        {
            padding: 0 10px 60px;
            max-width: 100%;
        }

        .menu-header {
            padding: 30px 15px 25px;
            border-radius: 0 0 15px 15px;
        }

        .menu-title {
            font-size: 2rem;
        }

        .category-title {
            font-size: 1.4rem;
            margin-top: 35px;
            margin-bottom: 20px;
            border-bottom-width: 3px;
        }

        .product-grid {
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
        }

        .product-card {
            border-radius: 12px;
        }

        .product-image {
            height: 140px;
        }

        .product-image-placeholder {
            height: 140px;
            font-size: 0.9rem;
        }

        .product-name {
            font-size: 1rem;
            min-height: 42px;
        }

        .product-description {
            font-size: 0.8rem;
            -webkit-line-clamp: 2;
        }

        #cart-sidebar {
            width: 100vw;
            height: 80vh;
            border-radius: 20px 20px 0 0;
            padding: 20px;
            bottom: 0;
            right: 0;
        }

        #cart-toggle {
            bottom: 15px;
            right: 15px;
            padding: 12px 18px;
            font-size: 0.9rem;
        }

        .cart-item img {
            width: 48px;
            height: 48px;
        }

        .cart-qty-input {
            width: 50px;
            font-size: 0.9rem;
        }

        }

        /* Мобильное меню открыто */
        #cart-sidebar.mobile-open {
            display: flex !important;
        }

    </style>
}

<div class="menu-header">
    <h1 class="menu-title">Наше Меню</h1>
    @if (!string.IsNullOrEmpty(tableNumber))
    {
        <p class="menu-subtitle">Вы за столом номер: <strong>@tableNumber</strong>. Выберите блюда для заказа.</p>
    }
    else
    {
        <p class="menu-subtitle">Выберите блюда и напитки из нашего ассортимента.</p>
    }
</div>

<div class="container position-relative">
    <div id="cart-sidebar">
        <h4>🛒 Корзина</h4>
        <div id="cart-items"></div>
        <div id="cart-total" class="mt-3 mb-2 fw-bold"></div>
        <button id="cart-submit" class="btn btn-success w-100">Отправить заказ</button>
        <button id="cart-close" class="btn btn-link w-100 mt-2">Закрыть</button>
    </div>
    <button id="cart-toggle" class="btn btn-primary">🛒 Корзина <span id="cart-count" class="badge bg-light text-dark">0</span></button>

    @if (Model.Any())
    {
        @foreach (var category in Model)
        {
            <h2 class="category-title">@category.Name</h2>
            <div class="product-grid">
                @foreach (var product in category.Products)
                {
                    <div class="product-card" data-product-id="@product.Id">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <div class="product-image" style="background-image: url('@product.ImagePath')"></div>
                        }
                        else
                        {
                            <div class="product-image-placeholder">
                                <span>Нет изображения</span>
                            </div>
                        }
                        <div class="product-info">
                            <h3 class="product-name">@product.Name</h3>
                            <!-- <p class="product-description"></p>-->
                            <div class="product-footer">
                                <span class="product-price">
                                    @product.Price.ToString("C", new System.Globalization.CultureInfo("kk-KZ"))
                                </span>

                                <button class="btn btn-add-to-cart">В корзину</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-menu">
            <h3>Меню пока пустое</h3>
            <p>Мы скоро добавим сюда наши лучшие блюда. Загляните позже!</p>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
function renderCart(cart) {
    let html = '';
    let total = 0;
    if (!cart || cart.length === 0) {
        html = '<div class="text-muted">Корзина пуста</div>';
        $("#cart-total").text('');
    } else {
        for (const item of cart) {
            total += item.price * item.quantity;
            html += `<div class="d-flex align-items-center mb-2">
                <img src="${item.imagePath || ''}" style="width:48px;height:48px;object-fit:cover;border-radius:8px;margin-right:10px;">
                <div class="flex-grow-1">
                    <div>${item.name}</div>
                    <div class="small text-muted">${item.price.toLocaleString('ru-RU', {style:'currency',currency:'KZT'})} × <input type="number" min="1" value="${item.quantity}" data-id="${item.productId}" class="cart-qty-input" style="width:48px;"> </div>
                </div>
                <button class="btn btn-sm btn-danger ms-2 cart-remove" data-id="${item.productId}">✕</button>
            </div>`;
        }
        $("#cart-total").text('Итого: ' + total.toLocaleString('ru-RU', {style:'currency',currency:'KZT'}));
    }
    $("#cart-items").html(html);
    $("#cart-count").text(cart ? cart.reduce((s,x)=>s+x.quantity,0) : 0);
}

function loadCart() {
    $.get('/Menu/GetCart', function(cart) {
        renderCart(cart);
    });
}

    $(function() {
        // Инициализация
        function renderCart(cart) {
            let html = '';
            let total = 0;
            if (!cart || cart.length === 0) {
                html = '<div class="text-muted">Корзина пуста</div>';
                $("#cart-total").text('');
            } else {
                for (const item of cart) {
                    total += item.price * item.quantity;
                    html += `<div class="cart-item">
                        <img src="${item.imagePath || ''}" alt="${item.name}">
                        <div class="cart-item-details">
                            <div class="cart-item-name">${item.name}</div>
                            <div class="cart-item-price">${item.price.toLocaleString('ru-RU', {style:'currency',currency:'KZT'})} ×
                                <input type="number" min="1" value="${item.quantity}" data-id="${item.productId}" class="cart-qty-input">
                            </div>
                        </div>
                        <button class="cart-remove" data-id="${item.productId}">✕</button>
                    </div>`;
                }
                $("#cart-total").text('Итого: ' + total.toLocaleString('ru-RU', {style:'currency',currency:'KZT'}));
            }
            $("#cart-items").html(html);
            $("#cart-count").text(cart ? cart.reduce((s,x)=>s+x.quantity,0) : 0);
        }

        function loadCart() {
            $.get('/Menu/GetCart', function(cart) {
                renderCart(cart);
            });
        }

        // Показать/скрыть корзину с анимацией
        $('#cart-toggle').on('click', function() {
            const sidebar = $('#cart-sidebar');
            sidebar.toggleClass('open');
            if(sidebar.hasClass('open')) {
                loadCart();
            }
        });

        $('#cart-close').on('click', function() {
            $('#cart-sidebar').removeClass('open');
        });

        // Отправка заказа
        $('#cart-submit').on('click', function() {
            var qrCode = '@(ViewData["QrCode"] ?? "")';
            if (!qrCode) {
                alert('QR-код не найден.');
                return;
            }
            $.post('/Menu/SubmitOrder', { qrCode }, function(resp) {
                if (resp.success) {
                    alert('Заказ успешно отправлен!');
                    renderCart([]);
                    $('#cart-sidebar').removeClass('open');
                } else {
                    alert(resp.message || 'Ошибка при отправке заказа');
                }
            });
        });

        // Добавить в корзину
        $('.btn-add-to-cart').on('click', function() {
            const productId = $(this).closest('.product-card').data('product-id');
            $.post('/Menu/AddToCart', { productId }, function(cart) {
                renderCart(cart);
            });
        });

        // Удалить из корзины
        $('#cart-items').on('click', '.cart-remove', function() {
            const productId = $(this).data('id');
            $.post('/Menu/RemoveFromCart', { productId }, function(cart) {
                renderCart(cart);
            });
        });

        // Изменить количество
        $('#cart-items').on('change', '.cart-qty-input', function() {
            const productId = $(this).data('id');
            let quantity = parseInt($(this).val());
            if (isNaN(quantity) || quantity < 1) quantity = 1;
            $.post('/Menu/UpdateCart', { productId, quantity }, function(cart) {
                renderCart(cart);
            });
        });

        // Загрузка корзины при старте
        loadCart();
        $('#cart-sidebar').removeClass('open'); // Скрыть корзину по-умолчанию
    });

</script>
