@model List<Restaurant.Entities.Category>
@{
    ViewData["Title"] = "Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tableNumber = ViewData["TableNumber"] as string;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@section Styles {
    <style>
        /* Общие стили */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f9f9fb;
            margin: 0;
            padding: 0;
            color: #222;
        }

        /* Центрируем контейнер, максимальная ширина для ПК */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px 40px;
        }

        /* Заголовок меню */
        .menu-header {
            text-align: center;
            padding: 40px 20px 30px;
            background: linear-gradient(135deg, #563d7c, #8b5fbf);
            color: white;
            border-radius: 0 0 30px 30px;
            box-shadow: 0 4px 20px rgba(86, 61, 124, 0.4);
        }

        .menu-title {
            font-size: 2.8rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .menu-subtitle {
            font-size: 1.1rem;
            opacity: 0.85;
        }

        /* Категории */
        .category-title {
            font-size: 1.8rem;
            font-weight: 700;
            border-bottom: 4px solid #8b5fbf;
            padding-bottom: 10px;
            margin-top: 50px;
            margin-bottom: 25px;
            color: #3b2e5a;
        }

        /* Сетка продуктов */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        /* Карточка продукта */
        .product-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 16px rgb(0 0 0 / 0.08);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 25px rgb(86 61 124 / 0.3);
            }

        .product-image {
            height: 160px;
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
            background-color: #f7f6fb;
            border-bottom: 1px solid #eee;
        }

        .product-image-placeholder {
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #aaa;
            font-size: 0.95rem;
            border-bottom: 1px solid #eee;
        }

        .product-info {
            padding: 15px 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .product-name {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #2a1a4d;
            min-height: 48px;
        }

        .product-description {
            font-size: 0.85rem;
            color: #666;
            flex-grow: 1;
            line-height: 1.3;
            margin-bottom: 15px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-price {
            font-size: 1.2rem;
            font-weight: 900;
            color: #663399;
        }

        .btn-add-to-cart {
            background: #663399;
            color: white;
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-add-to-cart:hover {
                background-color: #512c91;
            }

            .btn-add-to-cart:active {
                transform: scale(0.96);
            }

        /* Корзина — кнопка */
        #cart-toggle {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: linear-gradient(135deg, #663399, #8b5fbf);
            border: none;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            padding: 14px 22px;
            border-radius: 50px;
            box-shadow: 0 8px 20px rgba(102, 51, 153, 0.45);
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
            z-index: 1100;
            transition: background-color 0.3s ease;
        }

            #cart-toggle:hover {
                background-color: #512c91;
            }

            #cart-toggle:active {
                transform: scale(0.95);
            }

        /* Счётчик */
        #cart-count {
            background: #e83e8c;
            color: white;
            font-weight: 900;
            font-size: 0.85rem;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Боковая панель корзины */
        #cart-sidebar {
            position: fixed;
            bottom: 0;
            right: 0;
            width: 380px;
            max-width: 90vw;
            height: 80vh;
            background: white;
            border-radius: 20px 0 0 0;
            box-shadow: 0 -8px 30px rgba(86, 61, 124, 0.35);
            padding: 25px 30px;
            z-index: 1050;
            overflow-y: auto;
            display: none;
            flex-direction: column;
            transition: transform 0.3s ease;
        }

            /* Отображение панели */
            #cart-sidebar.open {
                display: flex;
            }

            /* Заголовок корзины */
            #cart-sidebar h4 {
                margin: 0 0 20px 0;
                font-size: 1.5rem;
                color: #3b2e5a;
                font-weight: 700;
            }

        /* Элементы корзины */
        #cart-items {
            flex-grow: 1;
            overflow-y: auto;
            max-height: calc(80vh - 180px);
        }

        /* Итого */
        #cart-total {
            font-size: 1.25rem;
            font-weight: 700;
            color: #663399;
            border-top: 2px solid #e9ecef;
            padding-top: 15px;
            margin-top: 15px;
            text-align: right;
        }

        /* Кнопки внизу */
        #cart-submit {
            width: 100%;
            background: #663399;
            border: none;
            color: white;
            font-weight: 700;
            padding: 16px 0;
            border-radius: 12px;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 15px;
            transition: background-color 0.3s ease;
        }

            #cart-submit:hover {
                background-color: #512c91;
                transform: translateY(-2px);
            }

            #cart-submit:active {
                transform: scale(0.97);
            }

        /* Стили для кнопки закрытия */
        #cart-close {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            transition: all 0.2s ease;
        }

            #cart-close:hover {
                background: rgba(102, 51, 153, 0.1);
                transform: scale(1.1);
            }

            #cart-close:active {
                transform: scale(0.95);
            }

        /* Элемент корзины */
        .cart-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 16px;
            background: #f8f9fa;
            border-radius: 12px;
            margin-bottom: 12px;
            transition: all 0.2s;
        }

            .cart-item:hover {
                background: #f1f3f5;
                transform: translateX(2px);
            }

            .cart-item img {
                width: 60px;
                height: 60px;
                object-fit: cover;
                border-radius: 8px;
            }

        .cart-item-details {
            flex-grow: 1;
            min-width: 0;
        }

        .cart-item-name {
            font-weight: 700;
            font-size: 1rem;
            color: #2a1a4d;
            margin-bottom: 4px;
        }

        .cart-item-price {
            font-size: 0.95rem;
            color: #663399;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-controls {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 4px 8px;
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .cart-qty-input {
            width: 50px;
            padding: 6px;
            border: 1px solid #ddd;
            border-radius: 6px;
            text-align: center;
            font-size: 1rem;
            font-weight: 600;
        }

        .btn-qty {
            width: 32px;
            height: 32px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background: white;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
        }

            .btn-qty:hover {
                background: #f0f0f0;
                border-color: #ccc;
            }

        /* Кнопка удаления */
        /* Кнопка удаления — теперь с отступом */
        .cart-remove {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: transparent;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-left: 8px; /* Отступ слева */
        }

            .cart-remove:hover {
                background: rgba(220, 53, 69, 0.1);
                transform: scale(1.1);
                color: #c82333;
            }

            .cart-remove:active {
                transform: scale(0.95);
            }

        /* Мобильные стили */
        @@media (max-width: 767px) {
            /* Общие стили */
            body

        {
            font-size: 14px;
        }

        

        /* Контейнер */
        .container {
            padding: 0 10px 80px;
            max-width: 100%;
        }

        /* Заголовок меню */
        .menu-header {
            padding: 30px 15px 25px;
            border-radius: 0 0 15px 15px;
        }

        .menu-title {
            font-size: 2rem;
            line-height: 1.2;
        }

        .menu-subtitle {
            font-size: 0.9rem;
        }

        /* Категории */
        .category-title {
            font-size: 1.4rem;
            margin-top: 35px;
            margin-bottom: 20px;
            border-bottom-width: 3px;
        }

        /* Сетка продуктов */
        .product-grid {
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
        }

        /* Карточка продукта */
        .product-card {
            border-radius: 12px;
            box-shadow: 0 6px 12px rgb(0 0 0 / 0.06);
        }

        .product-image {
            height: 140px;
        }

        .product-image-placeholder {
            height: 140px;
            font-size: 0.9rem;
        }

        .product-name {
            font-size: 1rem;
            min-height: 42px;
        }

        .product-description {
            font-size: 0.8rem;
            -webkit-line-clamp: 2;
        }

        .product-price {
            font-size: 1.1rem;
        }

        .btn-add-to-cart {
            font-size: 0.9rem;
            width: 36px;
            height: 36px;
        }

        /* Корзина — кнопка */
        #cart-toggle {
            bottom: 15px;
            right: 15px;
            padding: 12px 18px;
            font-size: 0.9rem;
            border-radius: 40px;
        }

        #cart-count {
            width: 24px;
            height: 24px;
            font-size: 0.8rem;
        }

        /* Боковая панель корзины */
        #cart-sidebar {
            width: 100vw;
            height: 85vh;
            border-radius: 20px 20px 0 0;
            padding: 20px;
            bottom: 0;
            right: 0;
            z-index: 1100;
        }

        #cart-items {
            max-height: calc(85vh - 180px);
        }

        /* Элементы корзины */
        .cart-item {
            flex-direction: column;
            align-items: flex-start;
            padding: 15px;
        }

            .cart-item img {
                width: 56px;
                height: 56px;
            }

        .cart-item-details {
            width: 100%;
        }

        .cart-item-price {
            width: 100%;
            justify-content: space-between;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .cart-controls {
            margin-top: 8px;
            width: 100%;
            justify-content: flex-end;
        }

        #cart-submit {
            font-size: 1rem;
            padding: 14px 0;
            border-radius: 10px;
        }

        #cart-close {
            font-size: 0.95rem;
            margin-top: 8px;
            padding: 8px 0;
        }

        }
    </style>
}

<div class="menu-header">
    <h1 class="menu-title">Наше Меню</h1>
    @if (!string.IsNullOrEmpty(tableNumber))
    {
        <p class="menu-subtitle">Вы за столом номер: <strong>@tableNumber</strong>. Выберите блюда для заказа.</p>
    }
    else
    {
        <p class="menu-subtitle">Выберите блюда и напитки из нашего ассортимента.</p>
    }
</div>

<div class="container position-relative">
    <div id="cart-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0 d-flex align-items-center">
                <i class="bi bi-cart-check me-2" style="color: #663399;"></i>
                Корзина
            </h4>
            <button id="cart-close" class="btn p-0" style="font-size: 1.6rem; color: #663399;">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>

        <div id="cart-items"></div>

        <div id="cart-total" class="mb-3 fw-bold"></div>
        <button id="cart-submit" class="btn btn-block w-100 mb-2">Отправить заказ</button>
    </div>

    <button id="cart-toggle" class="btn">
        <i class="bi bi-cart-check"></i>
        <span class="d-none d-md-inline">Корзина</span>
        <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge bg-danger">0</span>
    </button>

    @if (Model.Any())
    {
        @foreach (var category in Model)
        {
            <h2 class="category-title">@category.Name</h2>
            <div class="product-grid">
                @foreach (var product in category.Products)
                {
                    <div class="product-card" data-product-id="@product.Id">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <div class="product-image" style="background-image: url('@product.ImagePath')"></div>
                        }
                        else
                        {
                            <div class="product-image-placeholder">
                                <i class="bi bi-image" style="font-size: 2rem; color: #ddd;"></i>
                                <div class="mt-1">Нет изображения</div>
                            </div>
                        }
                        <div class="product-info">
                            <h3 class="product-name">@product.Name</h3>
                            <div class="product-footer">
                                <span class="product-price">
                                    @product.Price.ToString("C", new System.Globalization.CultureInfo("kk-KZ"))
                                </span>
                                <button class="btn btn-add-to-cart">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-menu text-center py-5">
            <i class="bi bi-emoji-frown" style="font-size: 3rem; color: #ddd;"></i>
            <h3 class="mt-3">Меню пока пустое</h3>
            <p class="mt-2">Мы скоро добавим сюда наши лучшие блюда. Загляните позже!</p>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function() {
        // Функция отображения корзины
        function renderCart(cart) {
            let html = '';
            let total = 0;

            if (!cart || cart.length === 0) {
                html = `
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
                        <p class="mt-3 fs-5">Корзина пуста</p>
                        <p class="text-muted">Добавьте товары для оформления заказа</p>
                    </div>`;
                $("#cart-total").text('');
            } else {
                cart.forEach(item => {
                    total += item.price * item.quantity;
                    const imagePath = item.imagePath || '/images/no-image.jpg';

                 html += `
                <div class="cart-item mb-3">
                    <img src="${item.imagePath || '/images/no-image.jpg'}"
                         alt="${item.name}"
                         onerror="this.src='/images/no-image.jpg'"
                         class="me-3 rounded"
                         style="width: 60px; height: 60px; object-fit: cover;">

                    <div class="flex-grow-1">
                        <h5 class="cart-item-name mb-1">${item.name}</h5>
                            <div class="d-flex justify-content-between align-items-center">
                                <!-- Цена слева -->
                                <div class="cart-item-price text-muted me-3">
                                    ${item.price.toLocaleString('ru-RU', {style: 'currency', currency: 'KZT'})}
                                </div>

                                <!-- Контролы количества справа -->
                                <div class="cart-controls">
                                    <button class="btn-qty btn-qty-minus">−</button>
                                    <input type="number" min="1" value="${item.quantity}"
                                           data-id="${item.productId}"
                                           class="cart-qty-input text-center">
                                    <button class="btn-qty btn-qty-plus">+</button>

                                    <!-- Кнопка удаления с отступом -->
                                    <button class="cart-remove ms-2" data-id="${item.productId}">
                                        <i class="bi bi-trash3" style="font-size: 1.2rem; color: #dc3545;"></i>
                                    </button>
                                </div>
                         </div>
                    </div>
                </div>`;
                });

                $("#cart-total").html(`Итого: ${total.toLocaleString('ru-RU', {style: 'currency', currency: 'KZT'})}`);
            }

            $("#cart-items").html(html);
            $("#cart-count").text(cart ? cart.reduce((sum, x) => sum + x.quantity, 0) : 0);
            $("#cart-count").toggleClass("d-none", cart.length === 0);
        }

        // Загрузка корзины с сервера
        function loadCart() {
            $.get('/Menu/GetCart', function(cart) {
                renderCart(cart);
            }).fail(function() {
                console.error("Ошибка загрузки корзины");
                renderCart([]);
            });
        }

        // Инициализация
        loadCart();
        $('#cart-sidebar').removeClass('open');

        // Показать/скрыть корзину
        $('#cart-toggle, #cart-close').on('click', function() {
            $('#cart-sidebar').toggleClass('open');
            if ($('#cart-sidebar').hasClass('open')) {
                loadCart();
            }
        });

        // Добавить в корзину
        $(document).on('click', '.btn-add-to-cart', function(e) {
            e.stopPropagation();
            const productId = $(this).closest('.product-card').data('product-id');

            $.post('/Menu/AddToCart', { productId }, function(cart) {
                renderCart(cart);
                // Анимация кнопки
                const btn = $(e.target).closest('button');
                btn.addClass('btn-success').find('i').removeClass('bi-plus-lg').addClass('bi-check-lg');
                setTimeout(() => {
                    btn.removeClass('btn-success').find('i').removeClass('bi-check-lg').addClass('bi-plus-lg');
                }, 1000);
            }).fail(function() {
                alert('Ошибка при добавлении товара в корзину');
            });
        });

        // Удалить из корзины
        $(document).on('click', '.cart-remove', function() {
            const productId = $(this).data('id');
            $.post('/Menu/RemoveFromCart', { productId }, function(cart) {
                renderCart(cart);
            }).fail(function() {
                alert('Ошибка при удалении товара');
            });
        });

        // Изменить количество +/- кнопки
        $(document).on('click', '.btn-qty', function() {
            const $input = $(this).siblings('.cart-qty-input');
            const productId = $input.data('id');
            let quantity = parseInt($input.val());

            if ($(this).hasClass('btn-qty-plus')) quantity++;
            else if ($(this).hasClass('btn-qty-minus')) quantity--;

            if (quantity < 1) quantity = 1;

            $input.val(quantity);
            $.post('/Menu/UpdateCart', { productId, quantity }, function(cart) {
                renderCart(cart);
            }).fail(function() {
                alert('Ошибка при обновлении количества');
            });
        });

        // Отправка заказа
        $('#cart-submit').on('click', function() {
            const qrCode = '@(ViewData["QrCode"] ?? "")';
            const $btn = $(this);
            if (!qrCode) {
                alert('QR-код не найден. Пожалуйста, отсканируйте QR-код на столе.');
                return;
            }

            

            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status"></span> Отправка...');

            $.post('/Menu/SubmitOrder', { qrCode }, function(resp) {
                $btn.prop('disabled', false).html('Отправить заказ');

                
    
                if (resp.success) {
                    const confirmation = confirm('Заказ успешно отправлен!\n\nНомер заказа: ' + resp.orderId + '\n\nХотите очистить корзину?');
                    if (confirmation) {
                        location.reload();
                        
                    }
                } else {
                    alert(resp.message || 'Ошибка при отправке заказа');
                }
            }).fail(function() {
                $btn.prop('disabled', false).html('Отправить заказ');
                alert('Ошибка сервера при отправке заказа');
            });
        });
    });
</script>